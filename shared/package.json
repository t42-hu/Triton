{
    "name": "@fullstack-starter/shared",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./calendar-import": {
            "types": "./dist/calendar-import.d.ts",
            "import": "./dist/calendar-import.js",
            "default": "./dist/calendar-import.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "zod": "^4.4.3",
        "ical.js": "2.2.1"
    },
    "devDependencies": {
        "typescript": "^6.0.3"
    }
}
