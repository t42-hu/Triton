index 0000000000000000000000000000000000000000..15cab924283645747204d0789acf1eda6854133f
--- /dev/null
+++ b/web/createStorageVFS.js
@@ -0,0 +1,11 @@
+/** Preserve named databases in memory only when the browser denies its file storage. */
+export async function createStorageVFS(persistent, memory) {
+  try {
+    return await persistent();
+  } catch (error) {
+    if (!['UnknownError', 'SecurityError', 'NotAllowedError', 'NotSupportedError', 'InvalidStateError'].includes(error?.name)) {
+      throw error;
+    }
+    return memory();
+  }
+}
