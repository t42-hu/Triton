# syntax=docker/dockerfile:1.7
FROM node:22.23.2-alpine@sha256:b6f26b36c8ff49624cfdac716b8ea1138d606df02586a77d364bb5536a634f85

ENV NODE_ENV=development \
    CHOKIDAR_USEPOLLING=true \
    PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml eslint.config.mjs ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
COPY frontend/universal/package.json frontend/universal/package.json
COPY shared/package.json shared/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

COPY backend backend
COPY shared shared
RUN pnpm --filter @fullstack-starter/shared build

EXPOSE 4000
CMD ["sh", "backend/dev-entrypoint.sh"]
