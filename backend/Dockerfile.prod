# syntax=docker/dockerfile:1.7
FROM node:22.23.2-alpine@sha256:b6f26b36c8ff49624cfdac716b8ea1138d606df02586a77d364bb5536a634f85 AS base

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml eslint.config.mjs ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
COPY frontend/universal/package.json frontend/universal/package.json
COPY shared/package.json shared/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

FROM deps AS builder
COPY backend backend
COPY shared shared
RUN pnpm --filter @fullstack-starter/shared build
RUN pnpm --filter @fullstack-starter/backend build
RUN pnpm deploy --filter @fullstack-starter/backend --prod /prod/backend

FROM node:22.23.2-alpine@sha256:b6f26b36c8ff49624cfdac716b8ea1138d606df02586a77d364bb5536a634f85 AS runner
ENV NODE_ENV=production \
    BACKEND_PORT=4000
WORKDIR /app
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
    && addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nestjs
COPY --from=builder --chown=nestjs:nodejs /prod/backend/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /app/backend/dist ./dist
COPY --from=builder --chown=nestjs:nodejs /app/backend/drizzle ./drizzle
COPY --from=builder --chown=nestjs:nodejs /prod/backend/package.json ./package.json
USER nestjs
EXPOSE 4000
CMD ["node", "dist/main.js"]
