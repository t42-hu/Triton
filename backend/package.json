{
    "name": "@fullstack-starter/backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "nest start --watch",
        "build": "nest build",
        "start": "node --import ./dist/observability/instrumentation.js dist/main.js",
        "start:prod": "node --import ./dist/observability/instrumentation.js dist/main.js",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:push": "drizzle-kit push",
        "db:migrate": "node --env-file-if-exists=../.env dist/database/migrate.js"
    },
    "dependencies": {
        "@better-auth/expo": "1.6.26",
        "@aws-sdk/client-s3": "^3.760.0",
        "@aws-sdk/client-sesv2": "^3.1048.0",
        "@fullstack-starter/shared": "workspace:*",
        "@nestjs/common": "^11.1.19",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.19",
        "@nestjs/platform-express": "^11.1.19",
        "@nestjs/platform-socket.io": "^11.1.19",
        "@nestjs/swagger": "11.4.7",
        "@nestjs/websockets": "^11.1.19",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/auto-instrumentations-node": "^0.80.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
        "@opentelemetry/instrumentation": "^0.222.0",
        "@opentelemetry/sdk-node": "^0.222.0",
        "@react-email/components": "^1.0.12",
        "@react-email/render": "^2.0.8",
        "@socket.io/redis-adapter": "^8.3.0",
        "@thallesp/nestjs-better-auth": "^2.7.0",
        "better-auth": "^1.6.25",
        "bullmq": "^5.76.8",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "express": "^5.2.1",
        "ioredis": "^5.11.1",
        "meilisearch": "0.58.0",
        "nestjs-pino": "^5.2.0",
        "nodemailer": "10.0.10",
        "pg": "^8.20.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "redis": "^5.12.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sharp": "0.35.4",
        "socket.io": "^4.8.3",
        "stripe": "^22.1.1",
        "zod": "^4.4.3"
