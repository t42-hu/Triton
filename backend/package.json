    "devDependencies": {
        "@nestjs/cli": "^11.0.21",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.0.0",
        "@types/node": "^25.7.0",
        "@types/nodemailer": "^7.0.0",
        "@types/pg": "^8.20.0",
        "@types/react": "^19.2.14",
        "drizzle-kit": "^0.31.10",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3"
    }
