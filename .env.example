# Application identity (pnpm project:init generates APP_ID and unique local secrets)
APP_ID=
APP_URL=
TRUSTED_ORIGINS=
APP_NAME=Fullstack Starter
APP_DOMAIN=
# Public name, URL, and auth URL are derived from APP_NAME and APP_URL.
NEXT_PUBLIC_APP_DESCRIPTION=Your application starts here.

# Local application addresses
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_AUTH_URL=
NEXT_PUBLIC_SOCKET_URL=/
BACKEND_INTERNAL_URL=http://localhost:4000
BACKEND_PORT=4000

# Structured JSON logs and optional OpenTelemetry trace export (OTLP/HTTP)
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional standard SDK settings: OTEL_EXPORTER_OTLP_TRACES_ENDPOINT,
# OTEL_EXPORTER_OTLP_HEADERS, OTEL_EXPORTER_OTLP_TRACES_HEADERS,
# OTEL_RESOURCE_ATTRIBUTES, OTEL_TRACES_SAMPLER, OTEL_TRACES_SAMPLER_ARG

# Native foundation for the Electron desktop client.
# Use the same unique scheme in the backend and native build.
NATIVE_AUTH_ENABLED=false
NATIVE_APP_SCHEME=
NATIVE_API_URL=
NATIVE_TRUSTED_ORIGINS=

# Desktop identity and packaging (public; change per product before generating builds)
APP_VERSION=0.1.0
ELECTRON_BUNDLE_ID=
ELECTRON_ICON=frontend/public/logo.svg
ELECTRON_MAINTAINER=
# Set NATIVE_TRUSTED_ORIGINS=app://localhost when enabling Electron auth.

# Expo iOS/Android/web client. Use a device-reachable API URL for a physical phone.
EXPO_AUTH_ENABLED=false
EXPO_API_URL=
EXPO_APP_SCHEME=
EXPO_WEB_ORIGIN=
EXPO_BUNDLE_ID=
EXPO_PROJECT_ID=
EXPO_VERSION_CODE=1

# Host bind addresses and ports (useful when running multiple cloned projects)
DEV_BIND_ADDRESS=127.0.0.1
DEV_INTERNAL_BIND_ADDRESS=127.0.0.1
DEV_HTTP_PORT=8080
DEV_FRONTEND_PORT=3000
DEV_BACKEND_PORT=4000
DEV_POSTGRES_PORT=5432
DEV_REDIS_PORT=6379
DEV_SEARCH_PORT=7700
DEV_CLAMAV_PORT=3310
PROD_HTTP_PORT=8080
PROD_BIND_ADDRESS=127.0.0.1

# Optional local service profiles
LOCAL_SERVICES_ENABLED=true
SEARCH_ENABLED=false
VIRUS_SCAN_ENABLED=true
STATSD_ENABLED=false
# Stores the System Stats agent's account link locally; keep it private.
STATSD_DATA_DIR=./statsd
VIRUS_SCANNER_HOST=localhost
VIRUS_SCANNER_PORT=3310
DEV_MAIL_PORT=8025
DEV_STORAGE_PORT=8333

# Core data services
POSTGRES_USER=starter
POSTGRES_PASSWORD=starter-local-password
POSTGRES_DB=starter
DATABASE_URL=postgresql://starter:starter-local-password@localhost:5432/starter
RUN_DATABASE_MIGRATIONS=false
CACHE_URL=redis://localhost:6379
SEARCH_ENGINE_URL=http://localhost:7700
SEARCH_ENGINE_MASTER_KEY=starter_dev_master_key
MEILI_ENV=development
MEILI_NO_ANALYTICS=true

# Core application security
BETTER_AUTH_SECRET=local-development-secret-change-in-production
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Optional social login; the UI enables configured providers automatically
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOWED_PRICE_IDS=

# Email: smtp for local Mailpit, ses for AWS, disabled to turn off
MAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional AWS SES email
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAIL_FROM=Fullstack Starter <noreply@example.com>
SES_CONFIGURATION_SET=

# Optional S3-compatible object storage
R2_ENDPOINT=
R2_REGION=us-east-1
R2_FORCE_PATH_STYLE=false
STORAGE_AUTO_CREATE_BUCKET=false
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Optional automatic Cloudflare Tunnel and DNS
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
DEV_APP_DOMAIN=
PROD_APP_DOMAIN=
DEV_CLOUDFLARE_TUNNEL_NAME=
PROD_CLOUDFLARE_TUNNEL_NAME=

# Optional prebuilt immutable release images
BACKEND_IMAGE=
FRONTEND_IMAGE=
