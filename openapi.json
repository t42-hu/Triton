                                    },
                                    "required": ["statusCode", "code", "message", "requestId"],
                                    "additionalProperties": false
                                }
                            }
                        }
                    }
                },
                "tags": ["native-auth"],
                "summary": "Hand off a password reset to a native app",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": { "flow": { "type": "string" }, "token": { "type": "string" } },
                                "required": ["flow", "token"]
                            }
                        }
                    }
                }
            }
        },
