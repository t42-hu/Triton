{"html":"<!doctype html><html lang=\"hu\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>NIK épülettérkép</title><style>.nik-map-app {\n  --nik-ink: #142b43;\n  --nik-muted: #65788b;\n  --nik-line: #dce5ea;\n  --nik-blue: #123a66;\n  --nik-cyan: #c5e3ed;\n  --nik-yellow: #f3c957;\n  --nik-green: #cce9da;\n  color: var(--nik-ink);\n  background: #f7f9f8;\n  font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  font-size: 15px;\n  line-height: 1.45;\n  min-width: 320px;\n}\n.nik-map-app *, .nik-map-app *::before, .nik-map-app *::after { box-sizing: border-box; }\n.nik-map-app button, .nik-map-app input { font: inherit; }\n.nik-map-app button { cursor: pointer; }\n.nik-layout { display: grid; grid-template-columns: minmax(280px, 340px) minmax(0, 1fr); min-height: 100vh; max-width: 1760px; margin: auto; background: #fff; box-shadow: 0 0 90px #213d5110; }\n.nik-sidebar { display: flex; flex-direction: column; min-width: 0; min-height: 100vh; padding: 28px 25px 18px; background: #f8faf9; border-right: 1px solid var(--nik-line); }\n.nik-brand { display: flex; align-items: center; gap: 11px; font-size: 12px; letter-spacing: .01em; color: var(--nik-muted); white-space: nowrap; }\n.nik-brand b { color: var(--nik-ink); }\n.nik-brand-mark { display: inline-grid; place-items: center; width: 34px; height: 34px; background: var(--nik-ink); color: #fff; font-size: 18px; font-weight: 900; transform: skew(-7deg); border-radius: 5px; }\n.nik-intro { padding-top: 54px; }\n.nik-eyebrow { color: #54768b; font-size: 10px; font-weight: 800; letter-spacing: .19em; }\n.nik-intro h1 { margin: 13px 0 13px; font-size: clamp(35px, 3vw, 45px); line-height: 1.04; letter-spacing: -.055em; font-weight: 800; }\n.nik-intro h1 em { color: #4f8d9e; font-style: normal; }\n.nik-intro p { margin: 0 0 34px; max-width: 260px; color: var(--nik-muted); font-size: 13px; line-height: 1.55; }\n.nik-search-label { display: block; margin-bottom: 8px; font-size: 12px; font-weight: 750; }\n.nik-search-wrap { position: relative; }\n.nik-search-wrap svg { position: absolute; left: 14px; top: 13px; width: 19px; height: 19px; fill: none; stroke: #748798; stroke-width: 1.9; stroke-linecap: round; pointer-events: none; }\n.nik-search { width: 100%; height: 47px; border: 1px solid #cddbe3; border-radius: 11px; padding: 0 12px 0 44px; background: white; outline: none; color: var(--nik-ink); box-shadow: 0 2px 6px #20354a08; }\n.nik-search:focus { border-color: #4d9cb4; box-shadow: 0 0 0 3px #4d9cb42c; }\n.nik-search::placeholder { color: #9aaab5; }\n.nik-section-heading { display: flex; align-items: center; justify-content: space-between; margin: 31px 0 11px; font-size: 12px; font-weight: 800; }\n.nik-section-heading span:last-child { color: #91a0aa; font-size: 11px; font-weight: 600; }\n.nik-floor-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; }\n.nik-floor-button { display: flex; align-items: center; gap: 8px; min-width: 0; height: 50px; border: 1px solid #e0e9ed; border-radius: 10px; padding: 8px; background: #fff; color: #50687a; text-align: left; font-size: 10px !important; font-weight: 700 !important; transition: .16s ease; }\n.nik-floor-button:hover { border-color: #8ebbc8; transform: translateY(-1px); }\n.nik-floor-button.is-active { border-color: var(--nik-ink); color: white; background: var(--nik-ink); box-shadow: 0 7px 15px #142b4324; }\n.nik-floor-number { flex: none; display: grid; place-items: center; width: 25px; height: 25px; border-radius: 6px; background: #ebf2f4; color: var(--nik-ink); font-size: 13px; font-weight: 900; }\n.nik-floor-button.is-active .nik-floor-number { background: #dceff3; }\n.nik-floor-chevron { display: none; margin-left: auto; }\n.nik-results-heading { margin-top: 30px; }\n.nik-results { display: grid; gap: 6px; max-height: 350px; overflow-y: auto; padding-right: 2px; scrollbar-color: #c5d6dd transparent; scrollbar-width: thin; }\n.nik-result { display: flex; align-items: center; gap: 10px; min-height: 55px; border: 1px solid transparent; border-radius: 9px; padding: 7px 8px; background: transparent; color: var(--nik-ink); text-align: left; transition: .14s ease; }\n.nik-result:hover, .nik-result:focus-visible { border-color: #d8e6eb; background: white; outline: none; }\n.nik-result-floor { flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; background: #e3edf1; color: #38576a; font-size: 13px; font-weight: 800; }\n.nik-result-copy { display: flex; flex-direction: column; min-width: 0; }\n.nik-result-copy strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; font-weight: 750; }\n.nik-result-copy small { color: #8494a1; font-size: 10px; }\n.nik-result-arrow { margin-left: auto; color: #97a6ae; font-size: 16px; }\n.nik-empty { padding: 20px 5px; color: var(--nik-muted); font-size: 12px; }\n.nik-sidebar-footer { margin-top: auto; padding-top: 20px; color: #9aaab2; font-size: 10px; }\n.nik-main { min-width: 0; padding: 25px clamp(20px, 4vw, 56px) 24px; background: linear-gradient(155deg, #fff 0%, #f6faf9 100%); }\n.nik-topline { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 35px; }\n.nik-pill { display: inline-flex; align-items: center; gap: 8px; border: 1px solid #d6e8e9; border-radius: 50px; padding: 6px 12px; color: #346676; background: #eef7f5; font-size: 9px; font-weight: 850; letter-spacing: .12em; white-space: nowrap; }\n.nik-live-dot { width: 6px; height: 6px; border-radius: 50%; background: #56a995; }\n.nik-topline-right { color: #98a9b2; font-size: 11px; font-weight: 600; }\n.nik-map-heading { display: flex; justify-content: space-between; align-items: flex-end; padding: 43px 3px 28px; }\n.nik-map-heading h2 { margin: 6px 0 2px; font-size: clamp(29px, 3vw, 43px); letter-spacing: -.05em; line-height: 1.1; }\n.nik-floor-caption { margin: 0; color: var(--nik-muted); font-size: 13px; }\n.nik-floor-index { color: #edf3f3; font-size: clamp(56px, 7vw, 105px); font-weight: 900; line-height: .8; letter-spacing: -.09em; }\n.nik-canvas-wrap { position: relative; overflow: hidden; border: 1px solid #dbe6e9; border-radius: 18px; background: #eff5f5; box-shadow: 0 16px 45px #23435610; touch-action: pan-y; }\n.nik-scroll-viewport { position: relative; overflow: hidden; aspect-ratio: 1200 / 700; min-height: 340px; }\n.nik-map-toolbar { position: absolute; top: 18px; left: 20px; right: 20px; z-index: 2; display: flex; justify-content: space-between; align-items: center; pointer-events: none; color: #76919d; font-size: 10px; font-weight: 850; letter-spacing: .15em; }\n.nik-zoom { display: flex; pointer-events: auto; overflow: hidden; border: 1px solid #6e9eb177; border-radius: 9px; background: #173d58da; box-shadow: 0 3px 14px #0005; }\n.nik-zoom button { width: 37px; height: 34px; border: 0; border-left: 1px solid #638ca063; color: #dff4f5; background: transparent; font-size: 19px; }\n.nik-zoom button:first-child { border-left: 0; }\n.nik-zoom button:hover { background: #35627d; }\n.nik-svg { position: absolute; inset: 0; display: block; width: 100%; height: 100%; touch-action: pan-y; }\n.nik-map-grid { pointer-events: none; }\n.nik-shell { fill: #f9fcfc; stroke: #b6cbd6; stroke-width: 3; filter: drop-shadow(0 8px 16px #1946591c); }\n.nik-inset { fill: #eff5f5; stroke: #b6cbd6; stroke-width: 1.3; pointer-events: none; }\n.nik-corridor { fill: #dcecf0; stroke: #c3dbe2; stroke-width: 1.3; }\n.nik-line { fill: none; stroke: #aec8d3; stroke-width: 1.8; stroke-dasharray: 8 8; }\n.nik-street { fill: #a46765; font-size: 17px; font-weight: 850; letter-spacing: .16em; }\n.nik-entry-arrow { stroke: #bd7773; stroke-width: 4; fill: none; marker-end: none; }\n.nik-corridor-label { fill: #91aebb; font-size: 12px; font-weight: 750; text-anchor: middle; letter-spacing: .2em; }\n.nik-map-watermark { fill: #b1c5ca; font-size: 17px; font-weight: 800; letter-spacing: .17em; }\n.nik-place { cursor: pointer; outline: none; }\n.nik-place-shape { stroke: #fff; stroke-width: 5; transition: filter .14s ease, stroke .14s ease, transform .14s ease; }\n.nik-place:hover .nik-place-shape, .nik-place:focus-visible .nik-place-shape { stroke: #71a8b8; stroke-width: 5; filter: drop-shadow(0 3px 8px #0e355245); }\n.nik-place.is-selected .nik-place-shape { stroke: #e45c55; stroke-width: 8; filter: drop-shadow(0 5px 8px #5b263329); }\n.kind-teaching .nik-place-shape { fill: #193d64; }\n.kind-research .nik-place-shape { fill: #3a8198; }\n.kind-parking .nik-place-shape { fill: #718d9e; }\n.kind-roof .nik-place-shape { fill: #e8eef0; stroke: #bad0d7; }\n.kind-office .nik-place-shape { fill: #e7ad38; }\n.kind-service .nik-place-shape { fill: #a3d2df; }\n.kind-outdoor .nik-place-shape { fill: #cbe5d8; stroke: #a8d2c1; }\n.nik-place[data-place-id=\"f-court\"] .nik-place-shape,\n.nik-place[data-place-id=\"f-garden\"] .nik-place-shape { fill: url(#nik-garden); }\n.kind-circulation .nik-place-shape { fill: #c5dce6; }\n.nik-place[data-place-id=\"f-aula\"] .nik-place-shape { fill: #b8d8e4; stroke: none; }\n.nik-place[data-place-id=\"f-aula\"]:is(:hover, :focus-visible, .is-selected) .nik-place-shape { stroke: #e45c55; stroke-width: 5; }\n.nik-place[data-place-id=\"f-aula\"] .nik-place-label { fill: #24465a; }\n.nik-place[data-place-id=\"f-cafe\"] .nik-place-shape,\n.nik-place[data-place-id=\"1-nik\"] .nik-place-shape,\n.nik-place[data-place-id=\"2-nik\"] .nik-place-shape,\n.nik-place[data-place-id=\"3-nik\"] .nik-place-shape,\n.nik-place[data-place-id=\"4-nik\"] .nik-place-shape { fill: #193d64; }\n.nik-place[data-place-id=\"f-cafe\"] .nik-place-label,\n.nik-place[data-place-id=\"4-nik\"] .nik-place-label { fill: #fff; }\n.nik-place-label { fill: #fff; font-size: 17px; font-weight: 800; text-anchor: middle; dominant-baseline: central; pointer-events: none; paint-order: stroke; }\n.kind-office .nik-place-label, .kind-service .nik-place-label, .kind-outdoor .nik-place-label, .kind-circulation .nik-place-label { fill: #24465a; }\n.nik-marker-ring { fill: #fff; stroke: #5f9aab; stroke-width: 3; filter: drop-shadow(0 3px 7px #173a4b2a); }\n.nik-stair-glyph { transform-box: fill-box; transform-origin: center; }\n.nik-ground-stair-glyph { transform: scale(.48); }\n.nik-stair-platform { fill: #fff8df; stroke: #25566f; stroke-width: 3.5; filter: drop-shadow(0 4px 8px #173a4b3d); }\n.nik-stair-treads { fill: none; stroke: #25566f; stroke-width: 2.5; }\n.nik-stair-arrow { fill: none; stroke: #c52f32; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }\n.nik-place:is(:hover, :focus-visible, .is-selected) .nik-stair-platform { stroke: #e45c55; stroke-width: 4; }\n.nik-place[data-place-id=\"f-cafe\"] .nik-place-shape { stroke: #a8d2c1; stroke-width: 2; }\n.nik-place[data-place-id=\"f-cafe\"]:is(:hover, :focus-visible, .is-selected) .nik-place-shape { stroke: #e45c55; stroke-width: 5; }\n.kind-outdoor .nik-marker-ring { stroke: #82b89d; }\n.kind-circulation .nik-marker-ring { stroke: #7a9eb0; }\n.nik-place.is-selected .nik-marker-ring { stroke: #e45c55; stroke-width: 5; }\n.nik-marker-label { fill: #24465a; text-anchor: middle; dominant-baseline: central; font-size: 13px; font-weight: 900; pointer-events: none; }\n.nik-place:focus-visible .nik-marker-ring { stroke: #e45c55; }\n.nik-map-bottom { display: flex; justify-content: center; flex-wrap: wrap; gap: 11px 22px; border-top: 1px solid #d9e5e8; padding: 12px 10px; color: #63808f; background: #f7fbfa; font-size: 10px; font-weight: 750; }\n.nik-map-bottom > span { display: flex; align-items: center; gap: 6px; white-space: nowrap; }\n.nik-legend-dot { display: inline-block; width: 10px; height: 10px; border-radius: 3px; }\n.nik-legend-stairs { display: inline-block; width: 15px; height: 12px; border: 1.5px solid #25566f; border-radius: 2px; background: repeating-linear-gradient(90deg, #fff8df 0 2px, #25566f 2px 3px); }\n.nik-legend-dot.teaching { background: #193d64; }.nik-legend-dot.research { background: #3a8198; }.nik-legend-dot.office { background: #e7ad38; }.nik-legend-dot.service { background: #a3d2df; }.nik-legend-dot.outdoor { background: #cbe5d8; }\n.nik-detail { display: flex; align-items: center; min-height: 104px; margin-top: 18px; border: 1px solid #e0e9ea; border-radius: 13px; padding: 18px 22px; background: #fff; box-shadow: 0 5px 22px #204b5c08; }\n.nik-detail-idle { display: flex; align-items: center; gap: 15px; }\n.nik-detail-icon { display: grid; place-items: center; flex: none; width: 43px; height: 43px; border-radius: 12px; background: #e9f3f3; color: #497c8d; font-size: 25px; }\n.nik-detail strong { display: block; font-size: 13px; }\n.nik-detail p { margin: 3px 0 0; color: #7c909c; font-size: 12px; }\n.nik-detail-active { display: flex; width: 100%; justify-content: space-between; align-items: flex-start; gap: 18px; }\n.nik-detail-kicker { color: #4d91a0; font-size: 10px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }\n.nik-detail h3 { margin: 4px 0 0; font-size: 19px; line-height: 1.25; letter-spacing: -.025em; }\n.nik-detail-close { display: grid; place-items: center; flex: none; width: 31px; height: 31px; border: 1px solid #e4ecee; border-radius: 8px; background: #f6f9f9; color: #617986; font-size: 21px; line-height: 1; }\n.nik-detail-close:hover { background: #eaf2f4; }\n.nik-accuracy { margin: 12px 2px 0; color: #8b9da6; font-size: 10px; }\n.nik-map-app :is(button, input, .nik-place):focus-visible { outline: 3px solid #e46c64; outline-offset: 2px; }\n\n@media (max-width: 900px) {\n  .nik-layout { grid-template-columns: minmax(0, 1fr); }\n  .nik-sidebar { min-height: auto; padding: 18px 20px 17px; }\n  .nik-intro { padding-top: 24px; }\n  .nik-intro h1 { font-size: 32px; }\n  .nik-intro p { max-width: none; margin-bottom: 22px; }\n  .nik-section-heading { margin-top: 20px; }\n  .nik-floor-list { width: 100%; max-width: 100%; grid-template-columns: repeat(6, minmax(100px, 1fr)); overflow-x: auto; padding-bottom: 3px; }\n  .nik-results-heading, .nik-results, .nik-sidebar-footer { display: none; }\n  .nik-main { padding: 18px 20px 24px; }\n  .nik-map-heading { padding: 24px 2px 20px; }\n  .nik-floor-index { font-size: 70px; }\n}\n@media (max-width: 590px) {\n  .nik-stair-glyph { transform: scale(1.65); }\n  .nik-stair-glyph.nik-ground-stair-glyph { transform: scale(.48); }\n  .nik-topline-right { display: none; }\n  .nik-floor-button { min-width: 100px; }\n  .nik-results-heading { display: flex; }\n  .nik-results { display: grid; max-height: 165px; }\n  .nik-main { padding: 18px 12px 22px; }\n  .nik-map-heading { padding: 23px 5px 15px; }\n  .nik-floor-caption { max-width: 225px; font-size: 11px; }\n  .nik-floor-index { font-size: 56px; }\n  .nik-canvas-wrap { border-radius: 12px; }\n  .nik-scroll-viewport { min-height: 0; }\n  .nik-map-watermark { display: none; }\n  .nik-map-bottom { gap: 6px 10px; font-size: 9px; }\n  .nik-map-toolbar { top: 10px; left: 10px; right: 10px; font-size: 8px; }\n  .nik-map-toolbar > span:first-child { font-size: 0; }\n  .nik-map-toolbar > span:first-child::after { content: \"KÉT UJJAL NAGYÍTS\"; font-size: 8px; }\n  .nik-detail { padding: 14px 15px; }\n}\n\n/* F.02 side flight: unchanged width, length matches its 86-unit side. */\n.nik-place[data-place-id=\"f-stairs\"] .nik-ground-stair-glyph { transform: scale(1.134, .48); }\n</style></head><body style=\"margin:0\"><div id=\"app\"></div><script>                                                        \n                                                                                                   \n\n                        \n             \n                 \n               \n                \n                \n                  \n                \n                    \n                    \n            \n            \n                                   \n                \n                      \n                                                             \n \n\nconst FLOORS                                                   = [\n  { id: \"A\", name: \"Alagsor\", caption: \"Bécsi úti bejárat, porta és mélygarázs\" },\n  { id: \"F\", name: \"Földszint\", caption: \"Aula, előadók és közösségi terek\" },\n  { id: \"1\", name: \"1. emelet\", caption: \"Előadó, irodák és laborok\" },\n  { id: \"2\", name: \"2. emelet\", caption: \"Rektori terület, NIK és EKIK\" },\n  { id: \"3\", name: \"3. emelet\", caption: \"NIK intézetek\" },\n  { id: \"4\", name: \"4. emelet\", caption: \"Dékáni hivatal és NIK\" },\n];\n\n// A rajz a kihelyezett tájékoztató táblák szemléltető átrajzolása.\n// A teremszám-tartományok egy szárnyat jelölnek, nem az egyes ajtók helyét.\nconst PLACES = __TRITON_PLACES__;\nconst FLOOR_SHAPES = __TRITON_FLOOR_SHAPES__;\n\n                                                           \n\n                                                           \n\n                                \n                         \n                                    \n \n\n                                   \n                                 \n                                \n                  \n \n\nconst KIND_LABELS                            = {\n  teaching: \"Oktatás\",\n  office: \"Iroda\",\n  research: \"Kutatás\",\n  service: \"Szolgáltatás\",\n  outdoor: \"Kültér\",\n  circulation: \"Közlekedés\",\n  parking: \"Parkoló\",\n  roof: \"Tetőterasz\",\n};\n\nconst HIGHLIGHTS = [\"f-aula\", \"f-01\", \"f-cafe\", \"1-auditorium\", \"a-reception\", \"4-dean\"];\nconst mapHeight = floor => FLOOR_SHAPES[floor].viewBox[3];\nconst mapWidth = floor => FLOOR_SHAPES[floor].viewBox[2];\n\nfunction safe(value        )         {\n  return value.replace(/[&<>\"']/g, (char) => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" })[char] || char);\n}\n\nfunction normalize(value        )         {\n  return value.normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\").toLocaleLowerCase(\"hu-HU\");\n}\n\nfunction matches(place       , query        )          {\n  const needle = normalize(query.trim());\n  if (!needle) return true;\n  const haystack = normalize([place.name, place.code, place.short, place.floor, place.note, ...(place.keywords || [])].filter(Boolean).join(\" \"));\n  if (haystack.includes(needle)) return true;\n  const room = needle.match(/^([1-4])\\.(\\d{1,2})$/);\n  return !!(room && place.range && room[1] === place.range[0] && Number(room[2]) >= place.range[1] && Number(room[2]) <= place.range[2]);\n}\n\nfunction floorScenery(floor) {\n  if (floor === \"F\") {\n    return `<path class=\"nik-shell\" d=\"M118 255H410V270L563 204L1186 90L1235 214L1107 240V447H684V479H711C772 479 805 521 805 575C805 630.5 772 671 711 671H684V703H684V860H536V735H466V860H274V801H143V703H118Z\" />\n      <path class=\"nik-corridor\" d=\"M543 305L1082 193L1100 236L553 350H410V306H543ZM118 430H430V703H118ZM267 703H684V735H267ZM427 731H466V855H427Z\" />\n      <path class=\"nik-line\" d=\"M897 153L927 229\" />\n      <text class=\"nik-street\" x=\"405\" y=\"907\">FÖLDSZINTI BEJÁRAT</text>\n      <path class=\"nik-entrance-landing\" d=\"M430 731H466V752H430ZM430 808H466V837H430Z\" fill=\"#d2e4ea\" stroke=\"#9bbbc7\" stroke-width=\"1.5\"/><path d=\"M430 850H466\" stroke=\"#b54038\" stroke-width=\"2\"/>`;\n  }\n  const shape = FLOOR_SHAPES[floor];\n  const streets = floor === \"A\"\n    ? '<text class=\"nik-street\" x=\"345\" y=\"925\">BÉCSI ÚT</text>'\n    : floor === \"1\" ? '<text class=\"nik-street\" x=\"380\" y=\"230\" text-anchor=\"end\">DOBERDÓ ÚT</text>' : \"\";\n  return `<path class=\"nik-shell\" d=\"${shape.shell}\"/>\n    <path class=\"nik-corridor\" d=\"${shape.corridor}\"/>\n    ${shape.insets ? `<path class=\"nik-inset\" d=\"${shape.insets}\"/>` : \"\"}${streets}`;\n}\n\nfunction roomText(place, label, x, y) {\n  const angle = place.rotation || 0;\n  const fontSize = place.labelFontSize || 17;\n  return `<text class=\"nik-place-label\" x=\"${x}\" y=\"${y}\" transform=\"rotate(${angle} ${x} ${y})\" style=\"font-size:${fontSize}px\">${safe(label)}</text>`;\n}\n\nfunction placeSvg(place       , selected         )         {\n  const title = [place.code, place.name].filter(Boolean).join(\" · \");\n  const groundStair = place.symbol === \"stairs\";\n  // The reference sign shows open stair flights with risers and a top landing.\n  const stairLength = place.id === \"f-stairs\" ? 56 : place.id === \"f-entry-stairs\" ? 56 : 48;\n  const stairHalfWidth = (place.id === \"f-entry-stairs\" || place.id === \"f-stairs\") ? 18 : 11;\n  const count = place.id === \"f-stairs\" ? 10 : place.id === \"f-entry-stairs\" ? 10 : 8;\n  const tread = stairLength / count;\n  const start = -stairLength / 2;\n  // Plan view: both edges stay straight; height is shown only in the 3D view.\n  const steps = Array.from({length: count}, (_, i) => {\n    const x = start + i*tread, next = x+tread;\n    return `<path d=\"M${x} ${-stairHalfWidth}H${next}V${stairHalfWidth}H${x}Z\" fill=\"${i % 2 ? \"#e5f0f3\" : \"#d5e6ec\"}\" stroke=\"#527787\" stroke-width=\"1.1\"/>`;\n  }).join(\"\");\n  const end = stairLength/2;\n  const landing = `<path d=\"M${end} ${-stairHalfWidth}H${end+10}V${stairHalfWidth}H${end}Z\" fill=\"#d2e4ea\" stroke=\"#527787\" stroke-width=\"1.1\"/>`;\n  const groundFlight = `<g transform=\"translate(${place.x} ${place.y}) rotate(${place.rotation || 0})\" class=\"nik-floor-flight\">${steps}${landing}</g>`;\n  const shape = place.id === \"f-entrance\"\n    ? `<g transform=\"translate(${place.x} ${place.y})\"><path d=\"M0 -21L-14 -5H14ZM0 21L-14 5H14Z\" fill=\"#b53027\"/></g>`\n    : groundStair ? groundFlight : place.symbol === \"stairs\"\n    ? `<g transform=\"translate(${place.x} ${place.y}) rotate(${place.rotation || 0})\"><g class=\"nik-stair-glyph${place.floor === \"F\" ? \" nik-ground-stair-glyph\" : \"\"}\"><rect class=\"nik-stair-platform\" x=\"-38\" y=\"-23\" width=\"76\" height=\"46\" rx=\"5\"/><path class=\"nik-stair-treads\" d=\"M-29 -17V17M-19 -17V17M-9 -17V17M1 -17V17M11 -17V17M21 -17V17M31 -17V17\"/><path class=\"nik-stair-arrow\" d=\"M-27 0H27m-8 -7 8 7-8 7\"/></g></g>`\n    : place.path\n    ? `<path class=\"nik-place-shape\" d=\"${place.path}\" />${place.id === \"f-garden\" ? '<path class=\"nik-corridor\" d=\"M575 447H684V499H575ZM575 651H684V703H575Z\"/>' : \"\"}${roomText(place, place.short, place.x, place.y)}${(place.secondaryLabels || []).map((label) => roomText(place, label.text, label.x, label.y)).join(\"\")}`\n    : `<circle class=\"nik-marker-ring\" cx=\"${place.x}\" cy=\"${place.y}\" r=\"${place.floor === \"F\" ? 25 : 20}\" /><text class=\"nik-marker-label\" x=\"${place.x}\" y=\"${place.y}\">${safe(place.short)}</text>`;\n  return `<g class=\"nik-place kind-${place.tone || place.kind}${selected ? \" is-selected\" : \"\"}\" data-place-id=\"${place.id}\" role=\"button\" tabindex=\"0\" aria-label=\"${safe(title)}\">${shape}<title>${safe(title)}</title></g>`;\n}\n\nfunction resultHtml(place       )         {\n  const floor = FLOORS.find((item) => item.id === place.floor) ;\n  return `<button class=\"nik-result\" type=\"button\" data-place-id=\"${place.id}\">\n    <span class=\"nik-result-floor\">${safe(place.floor)}</span>\n    <span class=\"nik-result-copy\"><strong>${safe(place.code ? `${place.code} · ${place.name}` : place.name)}</strong><small>${safe(floor.name)} · ${KIND_LABELS[place.kind]}</small></span>\n    <span class=\"nik-result-arrow\" aria-hidden=\"true\">↗</span>\n  </button>`;\n}\n\nfunction mountNikMap(container             , options                = {})                   {\n  let currentFloor          = FLOORS.some((item) => item.id === options.initialFloor) ? options.initialFloor  : \"F\";\n  let selectedId                = null;\n  let query = \"\";\n  let zoom = 1;\n  let focusX = mapWidth(currentFloor) / 2;\n  let focusY = 350;\n  let dragStart                                                                  = null;\n  let dragging = false;\n  let suppressMapClick = false;\n  let pinchStart                                                                                                  = null;\n  const aborter = new AbortController();\n\n  container.classList.add(\"nik-map-app\");\n  container.innerHTML = `<div class=\"nik-layout\">\n    <aside class=\"nik-sidebar\" aria-label=\"Térkép kereső és szintek\">\n      <div class=\"nik-brand\"><span class=\"nik-brand-mark\">N</span><span>Óbudai Egyetem <b>· NIK</b></span></div>\n      <div class=\"nik-intro\"><span class=\"nik-eyebrow\">ÉPÜLETTÉRKÉP</span><h1>Találd meg<br /><em>a helyed.</em></h1><p>Termek, közösségi terek és szolgáltatások egy áttekinthető térképen.</p></div>\n      <label class=\"nik-search-label\" for=\"nik-search\">Mit keresel?</label>\n      <div class=\"nik-search-wrap\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 5 5\"/></svg><input id=\"nik-search\" class=\"nik-search\" type=\"search\" placeholder=\"Pl. F.03, büfé, lift…\" autocomplete=\"off\" /></div>\n      <div class=\"nik-section-heading\"><span>Szintek</span><span>6 szint</span></div>\n      <div class=\"nik-floor-list\" role=\"group\" aria-label=\"Szint kiválasztása\"></div>\n      <div class=\"nik-section-heading nik-results-heading\"><span class=\"nik-results-title\">Kiemelt helyek</span><span class=\"nik-results-count\"></span></div>\n      <div class=\"nik-results\" aria-live=\"polite\"></div>\n      <div class=\"nik-sidebar-footer\">Szemléltető térkép a kihelyezett táblák alapján.</div>\n    </aside>\n    <main class=\"nik-main\">\n      <div class=\"nik-topline\"><span class=\"nik-pill\"><span class=\"nik-live-dot\"></span> BELTÉRI TÉRKÉP</span><span class=\"nik-topline-right\">NIK · Bécsi út / Doberdó út</span></div>\n      <header class=\"nik-map-heading\"><div><span class=\"nik-eyebrow\">AKTUÁLIS SZINT</span><h2 class=\"nik-floor-title\"></h2><p class=\"nik-floor-caption\"></p></div><div class=\"nik-floor-index\" aria-hidden=\"true\"></div></header>\n      <div class=\"nik-canvas-wrap\"><div class=\"nik-map-toolbar\"><span>VÁZLATOS ALAPRAJZ</span><div class=\"nik-zoom\"><button type=\"button\" data-zoom=\"out\" aria-label=\"Kicsinyítés\">−</button><button type=\"button\" data-zoom=\"in\" aria-label=\"Nagyítás\">+</button><button type=\"button\" data-zoom=\"reset\" aria-label=\"Nézet visszaállítása\">↺</button></div></div>\n        <div class=\"nik-scroll-viewport\"><svg class=\"nik-svg\" viewBox=\"0 0 1200 700\" preserveAspectRatio=\"xMidYMid meet\" role=\"group\" aria-label=\"Kiválasztott szint interaktív térképe\"><defs><pattern id=\"nik-grid\" width=\"24\" height=\"24\" patternUnits=\"userSpaceOnUse\"><circle cx=\"1\" cy=\"1\" r=\"1\" fill=\"#d5e1e8\" /></pattern><pattern id=\"nik-garden\" width=\"9\" height=\"9\" patternUnits=\"userSpaceOnUse\" patternTransform=\"rotate(35)\"><rect width=\"9\" height=\"9\" fill=\"#f0f7f0\" /><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"9\" stroke=\"#c3dfd4\" stroke-width=\"3\" /></pattern></defs><g class=\"nik-map-content\"></g></svg></div>\n        <div class=\"nik-map-bottom\"><span><span class=\"nik-legend-dot teaching\"></span> Terem / NIK</span><span><span class=\"nik-legend-dot research\"></span> Kutatás</span><span><span class=\"nik-legend-dot office\"></span> Vezetőség</span><span><span class=\"nik-legend-dot service\"></span> Szolgáltatás</span><span><span class=\"nik-legend-dot outdoor\"></span> Kültér</span><span><span class=\"nik-legend-stairs\"></span> Lépcső</span></div>\n      </div>\n      <section class=\"nik-detail\" aria-live=\"polite\"></section>\n      <p class=\"nik-accuracy\">A fotókból szerkesztett, nem méretarányos tájékozódási térkép. A teremszám-tartományok szárnyakat jelölnek.</p>\n    </main>\n  </div>`;\n\n  const floorList = container.querySelector             (\".nik-floor-list\") ;\n  const results = container.querySelector             (\".nik-results\") ;\n  const mapContent = container.querySelector             (\".nik-map-content\") ;\n  const svg = container.querySelector               (\".nik-svg\") ;\n  const stage = container.querySelector             (\".nik-canvas-wrap\") ;\n  const detail = container.querySelector             (\".nik-detail\") ;\n  const search = container.querySelector                  (\".nik-search\") ;\n\n  function clampZoom(value        )         { return Math.max(0.5, Math.min(3, value)); }\n\n  function setViewBox() {\n    const [left, top, worldWidth, worldHeight] = FLOOR_SHAPES[currentFloor].viewBox;\n    const width = worldWidth / zoom;\n    const height = worldHeight / zoom;\n    focusX = zoom <= 1 ? left + worldWidth / 2 : Math.max(left + width / 2, Math.min(left + worldWidth - width / 2, focusX));\n    focusY = zoom <= 1 ? top + worldHeight / 2 : Math.max(top + height / 2, Math.min(top + worldHeight - height / 2, focusY));\n    svg.setAttribute(\"viewBox\", `${focusX - width / 2} ${focusY - height / 2} ${width} ${height}`);\n    svg.style.touchAction = zoom > 1 ? \"none\" : \"pan-y\";\n  }\n\n  function renderFloors()       {\n    floorList.innerHTML = FLOORS.map((floor) => `<button type=\"button\" class=\"nik-floor-button${floor.id === currentFloor ? \" is-active\" : \"\"}\" data-floor=\"${floor.id}\" aria-pressed=\"${floor.id === currentFloor}\"><span class=\"nik-floor-number\">${floor.id}</span><span>${safe(floor.name)}</span><span class=\"nik-floor-chevron\" aria-hidden=\"true\">↗</span></button>`).join(\"\");\n  }\n\n  function renderResults()       {\n    const found = query.trim()\n      ? PLACES.filter((place) => matches(place, query)).sort((a, b) => Number(normalize(b.code || \"\") === normalize(query.trim())) - Number(normalize(a.code || \"\") === normalize(query.trim()))).slice(0, 18)\n      : HIGHLIGHTS.map((id) => PLACES.find((place) => place.id === id) );\n    container.querySelector             (\".nik-results-title\") .textContent = query.trim() ? \"Találatok\" : \"Kiemelt helyek\";\n    container.querySelector             (\".nik-results-count\") .textContent = query.trim() ? `${found.length}${found.length === 18 ? \"+\" : \"\"}` : \"\";\n    results.innerHTML = found.length ? found.map(resultHtml).join(\"\") : `<div class=\"nik-empty\">Nincs találat. Próbálj teremszámot vagy helynevet.</div>`;\n  }\n\n  function renderMap()       {\n    const floor = FLOORS.find((item) => item.id === currentFloor) ;\n    container.querySelector             (\".nik-floor-title\") .textContent = floor.name;\n    container.querySelector             (\".nik-floor-caption\") .textContent = floor.caption;\n    container.querySelector             (\".nik-floor-index\") .textContent = floor.id;\n    mapContent.dataset.mapFloor = currentFloor;\n    mapContent.innerHTML = `<rect class=\"nik-map-grid\" x=\"-750\" y=\"-350\" width=\"3000\" height=\"1400\" fill=\"url(#nik-grid)\" />\n      ${currentFloor === \"F\" ? '<text class=\"nik-map-watermark\" x=\"76\" y=\"90\">ÓBUDAI EGYETEM / NIK</text>' : \"\"}\n      ${floorScenery(currentFloor)}\n      ${PLACES.filter((place) => place.floor === currentFloor).map((place) => placeSvg(place, selectedId === place.id)).join(\"\")}\n      ${currentFloor === \"F\" ? '<path d=\"M118 703H430\" fill=\"none\" stroke=\"#a8d2c1\" stroke-width=\"5\" pointer-events=\"none\" aria-hidden=\"true\"/>' : \"\"}`;\n    setViewBox();\n  }\n\n  function renderDetail()       {\n    const place = PLACES.find((item) => item.id === selectedId);\n    if (!place) {\n      detail.innerHTML = `<div class=\"nik-detail-idle\"><span class=\"nik-detail-icon\">↗</span><div><strong>Válassz egy helyet a térképen</strong><p>Kattints egy teremre, vagy keress rá név és teremszám alapján.</p></div></div>`;\n      return;\n    }\n    const floor = FLOORS.find((item) => item.id === place.floor) ;\n    detail.innerHTML = `<div class=\"nik-detail-active\"><div class=\"nik-detail-main\"><span class=\"nik-detail-kicker\">${safe(floor.name)} · ${KIND_LABELS[place.kind]}</span><h3>${safe(place.code ? `${place.code} · ${place.name}` : place.name)}</h3>${place.note ? `<p>${safe(place.note)}</p>` : \"\"}</div><button type=\"button\" class=\"nik-detail-close\" aria-label=\"Kijelölés törlése\">×</button></div>`;\n  }\n\n  function setFloor(floor         )       {\n    if (!FLOORS.some((item) => item.id === floor)) return;\n    currentFloor = floor;\n    if (PLACES.find((place) => place.id === selectedId)?.floor !== floor) selectedId = null;\n    zoom = 1;\n    focusX = mapWidth(floor) / 2;\n    focusY = 350;\n    renderFloors();\n    renderMap();\n    renderDetail();\n  }\n\n  function selectPlace(id        )       {\n    const place = PLACES.find((item) => item.id === id);\n    if (!place) return;\n    currentFloor = place.floor;\n    selectedId = place.id;\n    zoom = Math.max(zoom, 1.15);\n    focusX = place.x;\n    focusY = place.y;\n    renderFloors();\n    renderMap();\n    renderDetail();\n    options.onSelect?.(place);\n  }\n\n  container.addEventListener(\"click\", (event) => {\n    const target = event.target           ;\n    if (suppressMapClick && svg.contains(target)) { suppressMapClick = false; event.preventDefault(); return; }\n    const floorButton = target.closest             (\"[data-floor]\");\n    const placeButton = target.closest             (\"[data-place-id]\");\n    const zoomButton = target.closest             (\"[data-zoom]\");\n    if (floorButton) setFloor(floorButton.dataset.floor           );\n    else if (placeButton) selectPlace(placeButton.dataset.placeId );\n    else if (zoomButton) {\n      const direction = zoomButton.dataset.zoom;\n      zoom = direction === \"reset\" ? 1 : clampZoom(zoom + (direction === \"in\" ? 0.22 : -0.17));\n      if (direction === \"reset\") { focusX = mapWidth(currentFloor) / 2; focusY = mapHeight(currentFloor) / 2; }\n      setViewBox();\n    } else if (target.closest(\".nik-detail-close\")) {\n      selectedId = null;\n      renderMap();\n      renderDetail();\n    }\n  }, { signal: aborter.signal });\n\n  svg.addEventListener(\"pointerdown\", (event) => {\n    if (event.button !== 0 || pinchStart) return;\n    dragStart = { x: event.clientX, y: event.clientY, focusX, focusY };\n    dragging = false;\n    suppressMapClick = false;\n  }, { signal: aborter.signal });\n  svg.addEventListener(\"pointermove\", (event) => {\n    if (!dragStart || pinchStart || zoom <= 1) return;\n    const dx = event.clientX - dragStart.x;\n    const dy = event.clientY - dragStart.y;\n    if (event.pointerType === \"touch\" && !dragging && Math.hypot(dx, dy) < 9) return;\n    if (!dragging && Math.abs(dx) + Math.abs(dy) > 6) {\n      dragging = true;\n      svg.setPointerCapture(event.pointerId);\n    }\n    if (!dragging) return;\n    focusX = dragStart.focusX - dx * svg.viewBox.baseVal.width / svg.clientWidth;\n    focusY = dragStart.focusY - dy * svg.viewBox.baseVal.height / svg.clientHeight;\n    setViewBox();\n  }, { signal: aborter.signal });\n  svg.addEventListener(\"pointerup\", (event) => {\n    if (dragging) suppressMapClick = true;\n    dragStart = null;\n    dragging = false;\n    if (svg.hasPointerCapture(event.pointerId)) svg.releasePointerCapture(event.pointerId);\n  }, { signal: aborter.signal });\n  svg.addEventListener(\"pointercancel\", () => { dragStart = null; dragging = false; }, { signal: aborter.signal });\n  stage.addEventListener(\"touchstart\", (event) => {\n    if (event.touches.length !== 2) return;\n    const a = event.touches[0], b = event.touches[1];\n    pinchStart = { distance: Math.hypot(b.clientX - a.clientX, b.clientY - a.clientY), zoom, focusX, focusY, x: (a.clientX + b.clientX) / 2, y: (a.clientY + b.clientY) / 2 };\n    dragStart = null;\n    event.preventDefault();\n  }, { passive: false, signal: aborter.signal });\n  stage.addEventListener(\"touchmove\", (event) => {\n    if (!pinchStart || event.touches.length !== 2) return;\n    event.preventDefault();\n    const a = event.touches[0], b = event.touches[1];\n    const distance = Math.hypot(b.clientX - a.clientX, b.clientY - a.clientY);\n    const nextZoom = clampZoom(pinchStart.zoom * distance / Math.max(1, pinchStart.distance));\n    const midpointX = (a.clientX + b.clientX) / 2;\n    const midpointY = (a.clientY + b.clientY) / 2;\n    focusX = pinchStart.focusX - (midpointX - pinchStart.x) * mapWidth(currentFloor) / (nextZoom * svg.clientWidth);\n    focusY = pinchStart.focusY - (midpointY - pinchStart.y) * mapHeight(currentFloor) / (nextZoom * svg.clientHeight);\n    zoom = nextZoom;\n    setViewBox();\n  }, { passive: false, signal: aborter.signal });\n  stage.addEventListener(\"touchend\", (event) => { if (event.touches.length < 2) pinchStart = null; }, { signal: aborter.signal });\n  stage.addEventListener(\"touchcancel\", () => { pinchStart = null; }, { signal: aborter.signal });\n  for (const type of [\"gesturestart\", \"gesturechange\"]) {\n    stage.addEventListener(type, (event) => event.preventDefault(), { passive: false, signal: aborter.signal });\n  }\n  stage.addEventListener(\"wheel\", (event) => {\n    if (!event.ctrlKey && !event.metaKey) return;\n    event.preventDefault();\n    zoom = clampZoom(zoom + (event.deltaY < 0 ? 0.10 : -0.10));\n    setViewBox();\n  }, { passive: false, signal: aborter.signal });\n\n  container.addEventListener(\"keydown\", (event) => {\n    if ((event.key === \"Enter\" || event.key === \" \") && (event.target           ).matches(\".nik-place\")) {\n      event.preventDefault();\n      selectPlace((event.target               ).dataset.placeId );\n    }\n  }, { signal: aborter.signal });\n\n  search.addEventListener(\"input\", () => { query = search.value; renderResults(); }, { signal: aborter.signal });\n  renderFloors();\n  renderResults();\n  renderMap();\n  renderDetail();\n\n  return {\n    setFloor,\n    selectPlace,\n    destroy() { aborter.abort(); container.innerHTML = \"\"; container.classList.remove(\"nik-map-app\"); },\n  };\n}\n\nconst root = document.querySelector(\"#app\");\nif (root) mountNikMap(root);</script></body></html>"}
