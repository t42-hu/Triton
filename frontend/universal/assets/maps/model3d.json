{"html":"<!doctype html><html lang=\"hu\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>NIK 3D épülettérkép</title><style>.nik-3d-app {\n  --d3-ink: #19344a;\n  --d3-muted: #728694;\n  --d3-coral: #eb806d;\n  --d3-line: #dce6e9;\n  min-width: 320px;\n  color: var(--d3-ink);\n  background: #edf3f4;\n  font: 15px/1.45 Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n}\n.nik-3d-app *, .nik-3d-app *::before, .nik-3d-app *::after { box-sizing: border-box; }\n.nik-3d-app button, .nik-3d-app input { font: inherit; }\n.nik-3d-app button { cursor: pointer; }\n.d3-layout { display: grid; grid-template-columns: minmax(290px, 320px) minmax(0, 1fr); max-width: 1830px; min-height: 100vh; margin: 0 auto; background: #f7fafa; box-shadow: 0 0 85px #16344d18; }\n.d3-sidebar { display: flex; flex-direction: column; min-width: 0; min-height: 100vh; padding: 27px 23px 18px; background: #f9fbfa; border-right: 1px solid #dce5e8; }\n.d3-brand { display: flex; align-items: center; gap: 11px; color: #718796; font-size: 10px; line-height: 1.35; }\n.d3-brand strong { color: #203d50; font-size: 10px; }\n.d3-logo { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border-radius: 8px; color: #fff; background: #14354d; font-size: 20px; font-weight: 900; transform: skew(-6deg); }\n.d3-kicker { color: #4e8b9a; font-size: 10px; font-weight: 850; letter-spacing: .17em; }\n.d3-intro { padding: 54px 0 31px; }\n.d3-intro h1 { margin: 11px 0 16px; font-size: clamp(35px, 2.8vw, 43px); line-height: 1.05; letter-spacing: -.055em; }\n.d3-intro h1 em { color: #4f96a5; font-style: normal; }\n.d3-intro p { max-width: 260px; margin: 0; color: #718897; font-size: 12px; line-height: 1.55; }\n.d3-sidebar label { display: block; margin-bottom: 8px; font-size: 12px; font-weight: 750; }\n.d3-search-box { position: relative; }\n.d3-search-box > span { position: absolute; left: 13px; top: 4px; color: #7895a1; font-size: 30px; line-height: 1; pointer-events: none; }\n.d3-search-box input { width: 100%; height: 47px; border: 1px solid #cedee4; border-radius: 10px; padding: 0 12px 0 42px; outline: none; color: #17354a; background: #fff; font-size: 12px; box-shadow: 0 3px 10px #173a4f08; }\n.d3-search-box input::placeholder { color: #9aabb4; }\n.d3-search-box input:focus { border-color: #559cad; box-shadow: 0 0 0 3px #5cabb42b; }\n.d3-side-heading { display: flex; justify-content: space-between; margin: 27px 0 10px; color: #507184; font-size: 10px; font-weight: 850; letter-spacing: .16em; }\n.d3-side-heading span:last-child { color: #9cafb8; }\n.d3-floor-list { display: grid; gap: 5px; }\n.d3-floor { display: flex; align-items: center; gap: 10px; height: 41px; border: 1px solid #e6edef; border-radius: 8px; padding: 5px 10px; color: #5f7887; background: #fff; text-align: left; font-size: 12px !important; font-weight: 750 !important; transition: .15s ease; }\n.d3-floor:hover { border-color: #8fbac6; transform: translateX(2px); }\n.d3-floor.is-active { border-color: #173c5a; color: #fff; background: #173c5a; box-shadow: 0 7px 14px #173c5a28; }\n.d3-floor-id { display: grid; place-items: center; flex: none; width: 27px; height: 27px; border-radius: 6px; color: #27465a; background: #e7f0f2; font-size: 13px; font-weight: 900; }\n.d3-floor.is-active .d3-floor-id { background: #d0e8ed; }\n.d3-floor > span:last-child { margin-left: auto; font-size: 16px; color: #8ca5af; }\n.d3-floor.is-active > span:last-child { color: #d4e8eb; }\n.d3-results-heading { margin-top: 26px; }\n.d3-results { display: grid; gap: 4px; max-height: 322px; overflow-y: auto; scrollbar-color: #cadce2 transparent; scrollbar-width: thin; }\n.d3-result { display: flex; align-items: center; gap: 10px; min-height: 50px; border: 1px solid transparent; border-radius: 8px; padding: 5px; background: transparent; text-align: left; color: #25465a; }\n.d3-result:hover, .d3-result:focus-visible { border-color: #dce9ec; background: #fff; }\n.d3-result-floor { display: grid; place-items: center; flex: none; width: 28px; height: 28px; border-radius: 7px; color: #31596a; background: #e7f0f3; font-size: 12px; font-weight: 850; }\n.d3-result-copy { display: flex; flex-direction: column; min-width: 0; }\n.d3-result-copy strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; }\n.d3-result-copy small { color: #879da8; font-size: 10px; }\n.d3-result > span:last-child { margin-left: auto; color: #98aeb8; }\n.d3-empty { color: #8195a0; font-size: 12px; }\n.d3-sidebar-note { margin: auto 0 0; padding-top: 19px; color: #9aadb5; font-size: 10px; }\n.d3-main { min-width: 0; padding: 27px clamp(18px, 2.9vw, 47px) 22px; background: linear-gradient(165deg, #f8fbfa 0%, #edf3f5 100%); }\n.d3-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 15px; margin-bottom: 18px; }\n.d3-header h2 { margin: 7px 0 2px; font-size: clamp(34px, 3vw, 45px); line-height: 1.05; letter-spacing: -.05em; }\n.d3-floor-caption { margin: 0; color: #708998; font-size: 13px; }\n.d3-model-badge { display: inline-flex; align-items: center; gap: 8px; border: 1px solid #c7e2e5; border-radius: 50px; padding: 8px 12px; color: #518c9a; background: #f1fbfa; font-size: 9px; font-weight: 850; letter-spacing: .1em; white-space: nowrap; }\n.d3-model-badge i { width: 6px; height: 6px; border-radius: 50%; background: #69bea9; }\n.d3-stage { position: relative; overflow: hidden; border: 1px solid #204460; border-radius: 17px; background: #0a1c30; box-shadow: 0 17px 45px #173f562b; touch-action: pan-y; }\n.d3-stage-instruction { position: absolute; z-index: 3; left: 19px; top: 17px; display: flex; align-items: center; gap: 8px; color: #bdd8e0; font-size: 10px; font-weight: 750; letter-spacing: .03em; pointer-events: none; }\n.d3-instruction-mobile { display: none; }\n.d3-instruction-dot { width: 6px; height: 6px; border-radius: 50%; background: #65cdbb; box-shadow: 0 0 10px #65cdbb9a; }\n.d3-stage-controls { position: absolute; z-index: 3; top: 12px; right: 16px; display: flex; overflow: hidden; border: 1px solid #6e9eb177; border-radius: 9px; background: #173d58da; box-shadow: 0 3px 14px #0005; }\n.d3-stage-controls button { width: 37px; height: 34px; border: 0; border-left: 1px solid #638ca063; color: #dff4f5; background: transparent; font-size: 19px; }\n.d3-stage-controls button:first-child { border-left: 0; }\n.d3-stage-controls button:hover { background: #35627d; }\n.d3-viewbox { position: relative; overflow: hidden; aspect-ratio: 1000 / 720; min-height: 560px; }\n.d3-svg { position: absolute; inset: 0; display: block; width: 100%; height: 100%; cursor: grab; touch-action: pan-y; user-select: none; }\n.d3-svg:active { cursor: grabbing; }\n.d3-ground-grid path { fill: none; stroke: #375776; stroke-width: 1; opacity: .45; }\n.d3-world-label { fill: #61849b; font-size: 13px; font-weight: 800; letter-spacing: .2em; }\n.d3-slab { cursor: pointer; outline: none; opacity: .27; }\n.d3-slab.is-active { opacity: 1; }\n.d3-slab-face-side, .d3-slab-face-front { stroke: #a0cbd4; stroke-width: 1.3; }\n.d3-slab-face-top { stroke: #a7cfd8; stroke-width: 2; }\n.d3-slab:not(.is-active) .d3-slab-face-top { stroke: #6b9eb2; stroke-width: 2.3; }\n.d3-slab:hover { opacity: .7; }\n.d3-slab.is-active:hover { opacity: 1; }\n.d3-slab-label { fill: #d6edf2; font-size: 15px; font-weight: 900; text-anchor: middle; pointer-events: none; paint-order: stroke; stroke: #173e5a; stroke-width: 3; }\n.d3-corridor { fill: #d9edf2; stroke: #b6d1d9; stroke-width: 1.5; }\n.d3-room, .d3-marker { cursor: pointer; outline: none; }\n.d3-room-top { stroke: #f2fbfb; stroke-width: 2.5; }\n.d3-room-side, .d3-room-front { stroke: #b6d9e0; stroke-width: 1.2; }\n.d3-room:hover .d3-room-top, .d3-room:focus-visible .d3-room-top, .d3-room.is-selected .d3-room-top { stroke: #ff806f; stroke-width: 5; filter: drop-shadow(0 0 7px #ef8b64); }\n.d3-room-label { font-size: 11px; font-weight: 850; text-anchor: middle; dominant-baseline: central; pointer-events: none; paint-order: stroke; stroke: #173b5a64; stroke-width: 2; }\n.d3-marker-stem { fill: none; stroke: #8fd6db; stroke-width: 2.3; }\n.d3-marker-ring { fill: #eafdfe; stroke: #4c99af; stroke-width: 2.4; filter: drop-shadow(0 4px 5px #041c2b8a); }\n.d3-marker:hover .d3-marker-ring, .d3-marker:focus-visible .d3-marker-ring, .d3-marker.is-selected .d3-marker-ring { stroke: #ff806f; stroke-width: 4; }\n.d3-marker-label { fill: #1a4b60; font-size: 10px; font-weight: 900; text-anchor: middle; dominant-baseline: central; pointer-events: none; }\n.d3-stage-bottom { position: absolute; z-index: 3; left: 16px; right: 16px; bottom: 15px; display: flex; align-items: center; justify-content: space-between; pointer-events: none; }\n.d3-explode { display: flex; align-items: center; gap: 8px; height: 37px; border: 1px solid #74a7b58c; border-radius: 8px; padding: 0 12px; color: #d8edef; background: #173d58de; font-size: 11px !important; font-weight: 750 !important; pointer-events: auto; box-shadow: 0 4px 15px #0004; }\n.d3-explode:hover, .d3-explode.is-active { color: #fff; background: #2b6b7c; border-color: #86d1cf; }\n.d3-explode-icon { font-size: 17px; line-height: 1; }\n.d3-orbit-readout { color: #9cb9c5; font-size: 10px; }\n.d3-orbit-readout b { color: #d8f3ef; font-size: 11px; }\n.d3-rail { position: absolute; z-index: 3; top: 50%; right: 15px; display: grid; gap: 6px; transform: translateY(-50%); }\n.d3-rail-floor { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid #86b5c570; border-radius: 7px; color: #b7d5dc; background: #14354ccf; font-size: 12px !important; font-weight: 850 !important; }\n.d3-rail-floor:hover, .d3-rail-floor.is-active { border-color: #82d5d1; color: #11394c; background: #d7f2f0; }\n.d3-below { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: stretch; gap: 13px; margin-top: 14px; }\n.d3-detail { display: flex; align-items: center; gap: 14px; min-height: 88px; border: 1px solid #dce7e9; border-radius: 11px; padding: 13px 15px; background: #fff; }\n.d3-detail-icon { display: grid; place-items: center; flex: none; width: 43px; height: 43px; border-radius: 10px; color: #4b8c9a; background: #e8f3f4; font-size: 24px; }\n.d3-detail-icon.is-active { color: #fff; background: #1a536f; }\n.d3-detail strong { display: block; font-size: 13px; }\n.d3-detail p { margin: 3px 0 0; color: #8095a0; font-size: 11px; }\n.d3-detail-copy { min-width: 0; }\n.d3-detail-copy small { display: block; margin-bottom: 3px; color: #5799a4; font-size: 9px; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }\n.d3-detail-close { display: grid; place-items: center; flex: none; width: 31px; height: 31px; margin-left: auto; border: 1px solid #e1eaec; border-radius: 7px; color: #718994; background: #f7fafa; font-size: 20px; }\n.d3-detail-close:hover { background: #e9f2f4; }\n.d3-legend { display: grid; grid-template-columns: repeat(2, max-content); gap: 4px 12px; align-content: center; border: 1px solid #dce7e9; border-radius: 11px; padding: 11px 15px; color: #607b89; background: #fff; font-size: 10px; font-weight: 700; }\n.d3-legend > span { display: flex; align-items: center; gap: 5px; }\n.d3-dot { display: inline-block; width: 9px; height: 9px; border-radius: 2px; }\n.d3-dot.teaching { background: #2867a2; }.d3-dot.research { background: #4ca2aa; }.d3-dot.office { background: #eac466; }.d3-dot.service { background: #a7dce3; }.d3-dot.outdoor { background: #bfe5c8; }\n.d3-accuracy { margin: 10px 2px 0; color: #8aa0aa; font-size: 10px; }\n.nik-3d-app :is(button, input, .d3-room, .d3-marker, .d3-slab, .d3-svg):focus-visible { outline: 3px solid #eb806d; outline-offset: 2px; }\n\n@media (max-width: 1000px) {\n  .d3-layout { grid-template-columns: minmax(0, 1fr); }\n  .d3-sidebar { min-height: auto; padding: 18px 20px; }\n  .d3-intro { padding: 26px 0 21px; }\n  .d3-intro h1 { font-size: 33px; }\n  .d3-intro p { max-width: 550px; }\n  .d3-floor-list { width: 100%; max-width: 100%; grid-template-columns: repeat(6, minmax(101px, 1fr)); overflow-x: auto; }\n  .d3-floor { min-width: 101px; }\n  .d3-floor > span:last-child { display: none; }\n  .d3-results-heading, .d3-results, .d3-sidebar-note { display: none; }\n  .d3-main { padding: 21px 20px 26px; }\n}\n@media (max-width: 650px) {\n  .d3-results-heading { display: flex; }\n  .d3-results { display: grid; max-height: 155px; }\n  .d3-main { padding: 16px 11px 24px; }\n  .d3-header h2 { font-size: 32px; }\n  .d3-floor-caption { max-width: 190px; font-size: 11px; }\n  .d3-model-badge { padding: 7px 8px; font-size: 7px; }\n  .d3-stage { border-radius: 12px; }\n  .d3-viewbox { height: 505px; min-height: 0; aspect-ratio: auto; }\n  .d3-svg { inset: 0 auto auto 50%; width: 700px; max-width: none; height: 505px; transform: translateX(-50%); }\n  .d3-stage-instruction { top: 12px; left: 10px; max-width: 180px; font-size: 8px; line-height: 1.3; }\n  .d3-instruction-desktop { display: none; }\n  .d3-instruction-mobile { display: inline; }\n  .d3-stage-controls { top: 9px; right: 9px; }\n  .d3-stage-controls button { width: 31px; height: 30px; }\n  .d3-rail { display: none; }\n  .d3-stage-bottom { left: 9px; right: 9px; bottom: 9px; }\n  .d3-explode { height: 33px; padding: 0 9px; font-size: 9px !important; }\n  .d3-orbit-readout { font-size: 9px; }\n  .d3-below { grid-template-columns: 1fr; }\n  .d3-legend { display: flex; justify-content: center; flex-wrap: wrap; gap: 5px 11px; }\n  .d3-detail { padding: 12px; }\n}\n</style></head><body style=\"margin:0\"><div id=\"app\"></div><script>                                                        \n                                                                                                   \n\n                        \n             \n                 \n               \n                \n                \n                  \n                \n                    \n                    \n            \n            \n                                   \n                \n                      \n                                                             \n \n\nconst FLOORS                                                   = [\n  { id: \"A\", name: \"Alagsor\", caption: \"Bécsi úti bejárat, porta és mélygarázs\" },\n  { id: \"F\", name: \"Földszint\", caption: \"Aula, előadók és közösségi terek\" },\n  { id: \"1\", name: \"1. emelet\", caption: \"Előadó, irodák és laborok\" },\n  { id: \"2\", name: \"2. emelet\", caption: \"Rektori terület, NIK és EKIK\" },\n  { id: \"3\", name: \"3. emelet\", caption: \"NIK intézetek\" },\n  { id: \"4\", name: \"4. emelet\", caption: \"Dékáni hivatal és NIK\" },\n];\n\n// A rajz a kihelyezett tájékoztató táblák szemléltető átrajzolása.\n// A teremszám-tartományok egy szárnyat jelölnek, nem az egyes ajtók helyét.\nconst PLACES = __TRITON_PLACES__;\n\n                                                           \n\n                                                           \n\n                               \n                         \n                                    \n \n\n                                  \n                                 \n                                \n                    \n                  \n \n\n                               \n                                       \n                                                                                      \n\nconst CATEGORY                            = {\n  teaching: \"Oktatás\", office: \"Iroda\", research: \"Kutatás\",\n  service: \"Szolgáltatás\", outdoor: \"Kültér\", circulation: \"Közlekedés\", parking: \"Parkoló\", roof: \"Tetőterasz\",\n};\n\nconst COLORS                                                                                = {\n  teaching: { top: \"#2867a2\", front: \"#164674\", side: \"#123a65\", text: \"#ffffff\" },\n  office: { top: \"#eac466\", front: \"#bb8a38\", side: \"#a9762d\", text: \"#243749\" },\n  research: { top: \"#4ca2aa\", front: \"#2d707e\", side: \"#225b69\", text: \"#ffffff\" },\n  parking: { top: \"#718d9e\", front: \"#536e7d\", side: \"#405c6b\", text: \"#ffffff\" },\n  roof: { top: \"#e8eef0\", front: \"#bad0d7\", side: \"#a4bfca\", text: \"#24465a\" },\n  service: { top: \"#a7dce3\", front: \"#72afbd\", side: \"#5e9bab\", text: \"#214557\" },\n  outdoor: { top: \"#bfe5c8\", front: \"#9ec9aa\", side: \"#8aba98\", text: \"#2b5647\" },\n  circulation: { top: \"#cadde4\", front: \"#9bb6c4\", side: \"#86a6b5\", text: \"#24475a\" },\n};\n\nconst SIGN_COLORS = { ...COLORS, teaching: { ...COLORS.teaching, top: \"#193d64\" }, office: { ...COLORS.office, top: \"#e7ad38\" }, research: { ...COLORS.research, top: \"#3a8198\" }, service: { ...COLORS.service, top: \"#a3d2df\" } };\n\nconst FEATURED = [\"f-aula\", \"f-01\", \"f-cafe\", \"1-auditorium\", \"a-reception\", \"4-dean\"];\n\nfunction escapeHtml(value        )         {\n  return value.replace(/[&<>\"']/g, (char) => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" })[char] || char);\n}\n\nfunction normal(value        )         {\n  return value.normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\").toLocaleLowerCase(\"hu-HU\");\n}\n\nfunction matches(place       , query        )          {\n  const term = normal(query.trim());\n  if (!term) return true;\n  const text = normal([place.name, place.code, place.short, place.note, ...(place.keywords || [])].filter(Boolean).join(\" \"));\n  if (text.includes(term)) return true;\n  const room = term.match(/^([1-4])\\.(\\d{1,2})$/);\n  return !!(room && place.range && room[1] === place.range[0] && Number(room[2]) >= place.range[1] && Number(room[2]) <= place.range[2]);\n}\n\nfunction roomLabel(place       )         {\n  if (place.id === \"1-nik\" || place.id === \"2-nik\" || place.id === \"4-nik\" || place.id === \"3-nik\") return \"NIK\";\n  if (place.code) return place.code;\n  if (place.id === \"4-meeting\") return \"Tárgyaló\";\n  if (place.id === \"a-garage\") return \"Garázs\";\n  if (place.id === \"f-garden\") return \"Kert\";\n  return place.short;\n}\n\nconst FLOOR_SHAPES = __TRITON_FLOOR_SHAPES__;\n\n// Sample the authored cubic curves; retain all other vertices exactly.\nfunction outlines(path        )             {\n  const tokens = path.match(/[MLHVCZ]|-?\\d+(?:\\.\\d+)?/g) || [];\n  const result             = [];\n  let points           = [], x = 0, y = 0, i = 0, command = \"\";\n  const number = () => Number(tokens[i++]);\n  while (i < tokens.length) {\n    if (/^[A-Z]$/.test(tokens[i])) command = tokens[i++];\n    if (command === \"Z\") { if (points.length) result.push(points); points = []; command = \"\"; continue; }\n    if (command === \"M\" || command === \"L\") { x = number(); y = number(); points.push([x, y]); if (command === \"M\") command = \"L\"; }\n    else if (command === \"H\") { x = number(); points.push([x, y]); }\n    else if (command === \"V\") { y = number(); points.push([x, y]); }\n    else if (command === \"C\") {\n      const ax = number(), ay = number(), bx = number(), by = number(), ex = number(), ey = number();\n      for (let step = 1; step <= 12; step++) {\n        const t = step / 12, u = 1 - t;\n        points.push([u*u*u*x + 3*u*u*t*ax + 3*u*t*t*bx + t*t*t*ex, u*u*u*y + 3*u*u*t*ay + 3*u*t*t*by + t*t*t*ey]);\n      }\n      x = ex; y = ey;\n    } else throw new Error(`Unsupported floor outline command: ${command}`);\n  }\n  if (points.length) result.push(points);\n  return result;\n}\nfunction rawFootprints(place       )             { return outlines(place.path || \"\"); }\nfunction world(rawX        , rawY        , z        )         {\n  return [(rawX - 710) / 140, (rawY - 365) / 140, z];\n}\n\nfunction resultHtml(place       )         {\n  return `<button type=\"button\" class=\"d3-result\" data-place-id=\"${place.id}\"><span class=\"d3-result-floor\">${place.floor}</span><span class=\"d3-result-copy\"><strong>${escapeHtml(place.code ? `${place.code} · ${place.name}` : place.name)}</strong><small>${escapeHtml(FLOORS.find(f => f.id === place.floor) .name)} · ${CATEGORY[place.kind]}</small></span><span aria-hidden=\"true\">↗</span></button>`;\n}\n\nfunction defaultFloorView(floor) {\n  if (floor === \"3\") return { zoom: 2.77, shiftX: -46, shiftY: 395.5 };\n  if (floor === \"4\") return { zoom: 2.69, shiftX: -45, shiftY: 540.7 };\n  if (floor === \"1\") return { zoom: 1.04, shiftX: 73, shiftY: -137.4 };\n  if (floor === \"2\") return { zoom: 1.07, shiftX: 77.1, shiftY: -80.9 };\n  if (floor === \"A\") return { zoom: 1.4, shiftX: 82.6, shiftY: -414.3 };\n  return { zoom: 1, shiftX: 0, shiftY: 0 };\n}\n\nfunction mountNik3DMap(container             , options               = {})                  {\n  let floor          = FLOORS.some((item) => item.id === options.initialFloor) ? options.initialFloor  : \"F\";\n  let selectedId                = null;\n  let query = \"\";\n  let yaw = -0.66;\n  let pitch = 0.60;\n  let { zoom, shiftX, shiftY } = defaultFloorView(floor);\n  let exploded = false;\n  let pointerStart                                                              = null;\n  let pinchStart                                                                                                  = null;\n  let dragged = false;\n  let suppressModelClick = false;\n  const aborter = new AbortController();\n\n  container.classList.add(\"nik-3d-app\");\n  container.innerHTML = `<div class=\"d3-layout\">\n    <aside class=\"d3-sidebar\" aria-label=\"Épülettérkép kereső\">\n      <div class=\"d3-brand\"><span class=\"d3-logo\">N</span><span>Óbudai Egyetem<br /><strong>Neumann János Informatikai Kar</strong></span></div>\n      <div class=\"d3-intro\"><span class=\"d3-kicker\">INTERAKTÍV 3D ÉPÜLETMODELL</span><h1>Járd körbe<br /><em>az épületet.</em></h1><p>Forgasd a modellt, válassz szintet, és fedezd fel a termeket.</p></div>\n      <label for=\"d3-search\">Hová mennél?</label><div class=\"d3-search-box\"><span aria-hidden=\"true\">⌕</span><input id=\"d3-search\" type=\"search\" placeholder=\"Teremszám vagy hely neve\" autocomplete=\"off\" /></div>\n      <div class=\"d3-side-heading\"><span>SZINTEK</span><span class=\"d3-floor-count\">02 / 06</span></div><div class=\"d3-floor-list\" role=\"group\" aria-label=\"Szint kiválasztása\"></div>\n      <div class=\"d3-side-heading d3-results-heading\"><span class=\"d3-results-title\">KIEMELT HELYEK</span><span class=\"d3-results-count\"></span></div><div class=\"d3-results\" aria-live=\"polite\"></div>\n      <p class=\"d3-sidebar-note\">A modell a táblák alapján készült szemléltető rajz.</p>\n    </aside>\n    <main class=\"d3-main\"><header class=\"d3-header\"><div><span class=\"d3-kicker\">NIK / FELFEDEZŐ NÉZET</span><h2 class=\"d3-floor-title\"></h2><p class=\"d3-floor-caption\"></p></div><span class=\"d3-model-badge\"><i></i> FORGATHATÓ 3D MODELL</span></header>\n      <section class=\"d3-stage\" aria-label=\"Interaktív 3D épületmodell\">\n        <div class=\"d3-stage-instruction\"><span class=\"d3-instruction-dot\"></span> <span class=\"d3-instruction-desktop\">Húzd a forgatáshoz · Ctrl + görgetés: nagyítás</span><span class=\"d3-instruction-mobile\">Húzd oldalra · két ujjal nagyíts</span></div>\n        <div class=\"d3-stage-controls\"><button type=\"button\" data-control=\"zoom-out\" aria-label=\"Kicsinyítés\">−</button><button type=\"button\" data-control=\"zoom-in\" aria-label=\"Nagyítás\">+</button><button type=\"button\" data-control=\"reset\" aria-label=\"Nézet visszaállítása\">↺</button></div>\n        <div class=\"d3-viewbox\"><svg class=\"d3-svg\" viewBox=\"0 0 1000 720\" role=\"group\" tabindex=\"0\" aria-label=\"Forgatható épületmodell. Nyilakkal is forgatható.\"><defs><pattern id=\"d3-grid\" width=\"34\" height=\"34\" patternUnits=\"userSpaceOnUse\"><circle cx=\"2\" cy=\"2\" r=\"1\" fill=\"#31506b\" /></pattern><radialGradient id=\"d3-bg\"><stop offset=\"0\" stop-color=\"#173855\"/><stop offset=\"1\" stop-color=\"#0a1c30\"/></radialGradient><filter id=\"d3-glow\"><feDropShadow dx=\"0\" dy=\"7\" stdDeviation=\"8\" flood-color=\"#31b9cd\" flood-opacity=\".35\" /></filter></defs><g class=\"d3-scene\"></g></svg></div>\n        <div class=\"d3-stage-bottom\"><button class=\"d3-explode\" type=\"button\" data-control=\"explode\" aria-pressed=\"false\"><span class=\"d3-explode-icon\">▤</span> Szintek széthúzása</button><span class=\"d3-orbit-readout\">Forgatás: <b class=\"d3-angle\">−38°</b></span></div>\n        <div class=\"d3-rail\" role=\"group\" aria-label=\"Szintek\"></div>\n      </section>\n      <div class=\"d3-below\"><div class=\"d3-detail\" aria-live=\"polite\"></div><div class=\"d3-legend\"><span><i class=\"d3-dot teaching\"></i> Oktatás</span><span><i class=\"d3-dot research\"></i> Kutatás</span><span><i class=\"d3-dot office\"></i> Iroda</span><span><i class=\"d3-dot service\"></i> Szolgáltatás</span><span><i class=\"d3-dot outdoor\"></i> Kültér</span></div></div>\n      <p class=\"d3-accuracy\">A fotókból készült modell szemléltető, nem méretarányos. A teremszám-tartományok területeket jelölnek, nem pontos ajtóhelyeket.</p>\n    </main>\n  </div>`;\n\n  const scene = container.querySelector             (\".d3-scene\") ;\n  const svg = container.querySelector               (\".d3-svg\") ;\n  const stage = container.querySelector             (\".d3-stage\") ;\n  const results = container.querySelector             (\".d3-results\") ;\n  const detail = container.querySelector             (\".d3-detail\") ;\n  const search = container.querySelector                  (\"#d3-search\") ;\n\n  function cameraUnit()         {\n    return [Math.cos(pitch) * Math.sin(yaw), Math.cos(pitch) * Math.cos(yaw), Math.sin(pitch)];\n  }\n\n  function project(point        )                                          {\n    const [x, y, z] = point;\n    const forward = cameraUnit();\n    const right         = [Math.cos(yaw), -Math.sin(yaw), 0];\n    const up         = [-Math.sin(pitch) * Math.sin(yaw), -Math.sin(pitch) * Math.cos(yaw), Math.cos(pitch)];\n    const toward = x * forward[0] + y * forward[1] + z * forward[2];\n    const factor = 15 / (15 - toward);\n    const scale = 83 * zoom * factor;\n    return { x: 500 + shiftX + (x * right[0] + y * right[1]) * scale, y: 366 + shiftY - (x * up[0] + y * up[1] + z * up[2]) * scale, depth: toward };\n  }\n\n  function floorZ(id         )         {\n    const index = FLOORS.findIndex((item) => item.id === id);\n    return (index - 2.5) * (exploded ? 1.17 : 0.79);\n  }\n\n  function projectedPath(points          )         {\n    return points.map(project).map((p, i) => `${i ? \"L\" : \"M\"}${p.x.toFixed(2)} ${p.y.toFixed(2)}`).join(\"\") + \"Z\";\n  }\n\n  function rectToBox(rect                                  , z0        , z1        )      {\n    const [x1, y1, x2, y2] = rect;\n    const a = world(x1, y1, z0), b = world(x2, y2, z1);\n    return { x1: a[0], y1: a[1], x2: b[0], y2: b[1], z0, z1 };\n  }\n\n  function boxFaces(box     , color                                              , className        )         {\n    const { x1, y1, x2, y2, z0, z1 } = box;\n    const unit = cameraUnit();\n    const xSide = unit[0] >= 0 ? x2 : x1;\n    const ySide = unit[1] >= 0 ? y2 : y1;\n    const xFace           = [[xSide, y1, z0], [xSide, y2, z0], [xSide, y2, z1], [xSide, y1, z1]];\n    const yFace           = [[x1, ySide, z0], [x2, ySide, z0], [x2, ySide, z1], [x1, ySide, z1]];\n    const top           = [[x1, y1, z1], [x2, y1, z1], [x2, y2, z1], [x1, y2, z1]];\n    return `<path class=\"${className}-side\" d=\"${projectedPath(xFace)}\" fill=\"${color.side}\"/><path class=\"${className}-front\" d=\"${projectedPath(yFace)}\" fill=\"${color.front}\"/><path class=\"${className}-top\" d=\"${projectedPath(top)}\" fill=\"${color.top}\"/>`;\n  }\n\n  function extrude(outline          , z0        , z1        , color                                            , cls        )         {\n    const low = outline.map(([x,y]) => world(x,y,z0));\n    const top = outline.map(([x,y]) => world(x,y,z1));\n    const sides = low.map((p,i) => {\n      const j = (i+1)%low.length;\n      const quad = [p,low[j],top[j],top[i]];\n      return {quad, depth: quad.reduce((n,v) => n+project(v).depth,0)/4};\n    }).sort((a,b) => a.depth-b.depth);\n    return sides.map(({quad}) => `<path class=\"${cls}-side\" d=\"${projectedPath(quad)}\" fill=\"${color.front}\"/>`).join(\"\") + `<path class=\"${cls}-top\" d=\"${projectedPath(top)}\" fill=\"${color.top}\"/>`;\n  }\n  function slabSvg(id         , active         )         {\n    const z = floorZ(id);\n    const color = active ? {top:\"#eff8fb\",front:\"#8bb7c9\",side:\"#74a6bd\"} : {top:\"#3b6a83\",front:\"#274f68\",side:\"#23485f\"};\n    return `<g class=\"d3-slab${active ? \" is-active\" : \"\"}\" data-floor=\"${id}\" role=\"button\" tabindex=\"0\" aria-label=\"${escapeHtml(FLOORS.find(f => f.id === id) .name)}\">${outlines(FLOOR_SHAPES[id].shell).map(p => extrude(p,z-.10,z+.05,color,\"d3-slab-face\")).join(\"\")}</g>`;\n  }\n  function corridorSvg() {\n    const shape = FLOOR_SHAPES[floor];\n    const corridor = outlines(shape.corridor).map(p => `<path class=\"d3-corridor\" d=\"${projectedPath(p.map(([x,y]) => world(x,y,floorZ(floor)+.07)))}\"/>`).join(\"\");\n    const insets = outlines(shape.insets || \"\").map(p => `<path fill=\"#eff5f5\" stroke=\"#b6cbd6\" stroke-width=\"1\" d=\"${projectedPath(p.map(([x,y]) => world(x,y,floorZ(floor)+.08)))}\"/>`).join(\"\");\n    return corridor + insets;\n  }\n\n  function projectedRoomText(place, label, x, y, z, fill) {\n    const center = project(world(x, y, z));\n    const radians = (place.rotation || 0) * Math.PI / 180;\n    const direction = project(world(x + 20 * Math.cos(radians), y + 20 * Math.sin(radians), z));\n    let angle = place.rotation === undefined ? 0 : Math.atan2(direction.y - center.y, direction.x - center.x) * 180 / Math.PI;\n    if (angle > 90) angle -= 180;\n    if (angle < -90) angle += 180;\n    const fontSize = place.labelFontSize ? Math.min(11, place.labelFontSize * .72) : 11;\n    return `<text class=\"d3-room-label\" x=\"${center.x.toFixed(1)}\" y=\"${center.y.toFixed(1)}\" fill=\"${fill}\" transform=\"rotate(${angle.toFixed(1)} ${center.x.toFixed(1)} ${center.y.toFixed(1)})\" style=\"font-size:${fontSize}px\">${escapeHtml(label)}</text>`;\n  }\n\n  function roomSvg(place       )         {\n    const footprints = rawFootprints(place);\n    if (!footprints.length) return \"\";\n    const z = floorZ(floor);\n    const colors = place.id === \"f-aula\" ? { ...COLORS.circulation, top: \"#badce6\" } : (floor === \"F\" ? COLORS : SIGN_COLORS)[place.tone || place.kind];\n    const flat = place.kind === \"outdoor\" || place.kind === \"parking\" || place.kind === \"roof\";\n    const height = flat ? 0.035 : place.id === \"f-aula\" ? 0.035 : 0.29;\n    const selected = selectedId === place.id;\n    const passages = place.id === \"f-garden\" ? outlines(\"M575 447H684V499H575ZM575 651H684V703H575Z\").map(p => extrude(p,z+.15,z+.16,COLORS.circulation,\"d3-room\")).join(\"\") : \"\";\n    const roomFaces = footprints.map(outline => extrude(outline, z + .11, z + .11 + height, colors, \"d3-room\")).join(\"\");\n    const labelZ = z + 0.11 + height;\n    const secondary = (place.secondaryLabels || []).map((item) => projectedRoomText(place, item.text, item.x, item.y, labelZ, colors.text)).join(\"\");\n    const name = [place.code, place.name].filter(Boolean).join(\" · \");\n    return `<g class=\"d3-room${selected ? \" is-selected\" : \"\"}\" data-place-id=\"${place.id}\" role=\"button\" tabindex=\"0\" aria-label=\"${escapeHtml(name)}\">${roomFaces}${passages}${projectedRoomText(place, roomLabel(place), place.x, place.y, labelZ, colors.text)}${secondary}<title>${escapeHtml(name)}</title></g>`;\n  }\n\n  function markerSvg(place       )         {\n    if (place.id === \"f-entrance\") {\n      const z = floorZ(floor)+.17;\n      const arrows = [[ [448,829],[434,845],[462,845] ],[ [448,871],[434,855],[462,855] ]];\n      const landings = outlines(\"M430 731H466V752H430ZM430 808H466V837H430Z\").map(p => extrude(p,z-.03,z,COLORS.circulation,\"d3-room\")).join(\"\");\n      return `<g class=\"d3-marker\" data-place-id=\"${place.id}\" role=\"button\" tabindex=\"0\" aria-label=\"Földszinti bejárat\">${landings}${arrows.map(p => `<path d=\"${projectedPath(p.map(([x,y]) => world(x,y,z)))}\" fill=\"#b53027\"/>`).join(\"\")}<title>Földszinti bejárat</title></g>`;\n    }\n    if (place.symbol === \"stairs\") {\n      const z = floorZ(floor) + .16, angle = (place.rotation || 0) * Math.PI / 180;\n      const length = place.id === \"f-stairs\" ? 56 : place.id === \"f-entry-stairs\" ? 56 : 48;\n      const halfWidth = (place.id === \"f-entry-stairs\" || place.id === \"f-stairs\") ? 18 : 11;\n      const count = place.id === \"f-stairs\" ? 10 : place.id === \"f-entry-stairs\" ? 10 : 8;\n      const rotate = (x        , y        )         => [place.x+x*Math.cos(angle)-y*Math.sin(angle),place.y+x*Math.sin(angle)+y*Math.cos(angle)];\n      const footprint = (a        , b        ) => [rotate(a,-halfWidth),rotate(b,-halfWidth),rotate(b,halfWidth),rotate(a,halfWidth)];\n      const steps = Array.from({length: count}, (_,i) => extrude(footprint(-length/2+i*length/count,-length/2+(i+1)*length/count),z,z+.025*(i+1),COLORS.circulation,\"d3-room\")).join(\"\");\n      const landing = extrude(footprint(length/2,length/2+10),z,z+.025*count,COLORS.circulation,\"d3-room\");\n      return `<g class=\"d3-marker\" data-place-id=\"${place.id}\" role=\"button\" tabindex=\"0\" aria-label=\"${escapeHtml(place.name)}\">${steps}${landing}<title>${escapeHtml(place.name)}</title></g>`;\n    }\n    const z = floorZ(floor);\n    const base = project(world(place.x, place.y, z + 0.08));\n    const pin = project(world(place.x, place.y, z + 0.59));\n    const selected = selectedId === place.id;\n    return `<g class=\"d3-marker${selected ? \" is-selected\" : \"\"}\" data-place-id=\"${place.id}\" role=\"button\" tabindex=\"0\" aria-label=\"${escapeHtml(place.name)}\"><path class=\"d3-marker-stem\" d=\"M${base.x.toFixed(1)} ${base.y.toFixed(1)}L${pin.x.toFixed(1)} ${pin.y.toFixed(1)}\"/><circle class=\"d3-marker-ring\" cx=\"${pin.x.toFixed(1)}\" cy=\"${pin.y.toFixed(1)}\" r=\"17\"/><text class=\"d3-marker-label\" x=\"${pin.x.toFixed(1)}\" y=\"${pin.y.toFixed(1)}\">${escapeHtml(place.short)}</text><title>${escapeHtml(place.name)}</title></g>`;\n  }\n\n  function pointFitsRoom(point, paths) {\n    return paths.some((path) => path.isPointInFill(point.matrixTransform(path.getCTM().inverse())));\n  }\n\n  function labelFitsRoom(label, paths) {\n    const box = label.getBBox();\n    const matrix = label.getCTM();\n    const corners = [[box.x, box.y], [box.x + box.width, box.y], [box.x, box.y + box.height], [box.x + box.width, box.y + box.height]];\n    return corners.every(([x, y]) => pointFitsRoom(new DOMPoint(x, y).matrixTransform(matrix), paths));\n  }\n\n  function fitRoomLabel(label, paths) {\n    let fontSize = parseFloat(getComputedStyle(label).fontSize);\n    while (fontSize > 3 && !labelFitsRoom(label, paths)) {\n      fontSize -= .5;\n      label.style.fontSize = `${fontSize}px`;\n    }\n  }\n\n  function fitRoomLabels(room) {\n    const paths = [...room.querySelectorAll(\".d3-room-top\")];\n    room.querySelectorAll(\".d3-room-label\").forEach((label) => fitRoomLabel(label, paths));\n  }\n\n  function renderScene()       {\n    const others = FLOORS.filter((item) => item.id !== floor);\n    const activePlaces = PLACES.filter((place) => place.floor === floor);\n    const boxes = activePlaces.filter((place) => !!place.path).sort((a, b) => {\n      const za = floorZ(floor) + 0.22;\n      const da = project(world(a.x, a.y, za)).depth;\n      const db = project(world(b.x, b.y, za)).depth;\n      return da - db;\n    });\n    const gridLines = Array.from({ length: 9 }, (_, index) => {\n      const y = -4 + index;\n      return `<path d=\"${projectedPath([[-5, y, -2.85], [5, y, -2.85]])}\" />`;\n    }).join(\"\") + Array.from({ length: 11 }, (_, index) => {\n      const x = -5 + index;\n      return `<path d=\"${projectedPath([[x, -4, -2.85], [x, 4, -2.85]])}\" />`;\n    }).join(\"\");\n    scene.innerHTML = `<rect x=\"0\" y=\"0\" width=\"1000\" height=\"720\" fill=\"url(#d3-bg)\"/><rect x=\"0\" y=\"0\" width=\"1000\" height=\"720\" fill=\"url(#d3-grid)\" opacity=\".48\"/>\n      <g class=\"d3-ground-grid\">${gridLines}</g>\n      <text class=\"d3-world-label\" x=\"46\" y=\"670\">ÓBUDAI EGYETEM / NIK</text>\n      ${others.map((item) => slabSvg(item.id, false)).join(\"\")}\n      <g class=\"d3-active-model\" filter=\"url(#d3-glow)\">${slabSvg(floor, true)}${corridorSvg()}${boxes.map(roomSvg).join(\"\")}${activePlaces.filter((place) => !place.path).map(markerSvg).join(\"\")}</g>`;\n    scene.querySelectorAll(\".d3-room\").forEach(fitRoomLabels);\n    container.querySelector             (\".d3-angle\") .textContent = `${Math.round(yaw * 180 / Math.PI)}°`;\n  }\n\n  function renderFloors()       {\n    const current = FLOORS.find((item) => item.id === floor) ;\n    container.querySelector             (\".d3-floor-title\") .textContent = current.name;\n    container.querySelector             (\".d3-floor-caption\") .textContent = current.caption;\n    container.querySelector             (\".d3-floor-count\") .textContent = `${String(FLOORS.findIndex((item) => item.id === floor) + 1).padStart(2, \"0\")} / 06`;\n    container.querySelector             (\".d3-floor-list\") .innerHTML = FLOORS.map((item) => `<button type=\"button\" class=\"d3-floor${floor === item.id ? \" is-active\" : \"\"}\" data-floor=\"${item.id}\" aria-pressed=\"${floor === item.id}\"><span class=\"d3-floor-id\">${item.id}</span><span>${escapeHtml(item.name)}</span><span aria-hidden=\"true\">↗</span></button>`).join(\"\");\n    container.querySelector             (\".d3-rail\") .innerHTML = [...FLOORS].reverse().map((item) => `<button type=\"button\" class=\"d3-rail-floor${floor === item.id ? \" is-active\" : \"\"}\" data-floor=\"${item.id}\" aria-label=\"${escapeHtml(item.name)}\" aria-pressed=\"${floor === item.id}\">${item.id}</button>`).join(\"\");\n  }\n\n  function renderResults()       {\n    const found = query.trim()\n      ? PLACES.filter((place) => matches(place, query)).sort((a, b) => Number(normal(b.code || \"\") === normal(query.trim())) - Number(normal(a.code || \"\") === normal(query.trim()))).slice(0, 18)\n      : FEATURED.map((id) => PLACES.find((place) => place.id === id) );\n    container.querySelector             (\".d3-results-title\") .textContent = query.trim() ? \"TALÁLATOK\" : \"KIEMELT HELYEK\";\n    container.querySelector             (\".d3-results-count\") .textContent = query.trim() ? `${found.length}${found.length === 18 ? \"+\" : \"\"}` : \"\";\n    results.innerHTML = found.length ? found.map(resultHtml).join(\"\") : `<p class=\"d3-empty\">Nincs találat. Keress teremszámra vagy helynévre.</p>`;\n  }\n\n  function renderDetail()       {\n    const place = PLACES.find((item) => item.id === selectedId);\n    if (!place) {\n      detail.innerHTML = `<span class=\"d3-detail-icon\">⌖</span><div><strong>Válassz egy helyet a modellen</strong><p>Forgasd az épületet, vagy keress rá a teremszámra.</p></div>`;\n      return;\n    }\n    const current = FLOORS.find((item) => item.id === place.floor) ;\n    detail.innerHTML = `<span class=\"d3-detail-icon is-active\">↗</span><div class=\"d3-detail-copy\"><small>${escapeHtml(current.name)} · ${CATEGORY[place.kind]}</small><strong>${escapeHtml(place.code ? `${place.code} · ${place.name}` : place.name)}</strong>${place.note ? `<p>${escapeHtml(place.note)}</p>` : \"\"}</div><button type=\"button\" class=\"d3-detail-close\" aria-label=\"Kijelölés törlése\">×</button>`;\n  }\n\n  function render()       { renderFloors(); renderScene(); renderDetail(); }\n\n  function setFloor(next         )       {\n    if (!FLOORS.some((item) => item.id === next)) return;\n    floor = next;\n    ({ zoom, shiftX, shiftY } = defaultFloorView(floor));\n    if (PLACES.find((place) => place.id === selectedId)?.floor !== floor) selectedId = null;\n    render();\n  }\n\n  function selectPlace(id        )       {\n    const place = PLACES.find((item) => item.id === id);\n    if (!place) return;\n    floor = place.floor;\n    selectedId = id;\n    render();\n    options.onSelect?.(place);\n  }\n\n  function resetView()       {\n    yaw = -0.66; pitch = 0.60; ({ zoom, shiftX, shiftY } = defaultFloorView(floor)); exploded = false;\n    const toggle = container.querySelector                   (\".d3-explode\") ;\n    toggle.setAttribute(\"aria-pressed\", \"false\");\n    toggle.classList.remove(\"is-active\");\n    renderScene();\n  }\n\n  container.addEventListener(\"click\", (event) => {\n    const target = event.target           ;\n    if (suppressModelClick && target.closest(\".d3-svg\")) { suppressModelClick = false; return; }\n    suppressModelClick = false;\n    const placeButton = target.closest             (\"[data-place-id]\");\n    const floorButton = target.closest             (\"[data-floor]\");\n    const control = target.closest             (\"[data-control]\");\n    if (placeButton) selectPlace(placeButton.dataset.placeId );\n    else if (floorButton) setFloor(floorButton.dataset.floor           );\n    else if (control) {\n      switch (control.dataset.control) {\n        case \"zoom-in\": zoom = Math.min(3, zoom + 0.22); renderScene(); break;\n        case \"zoom-out\": zoom = Math.max(0.5, zoom - 0.17); renderScene(); break;\n        case \"reset\": resetView(); break;\n        case \"explode\":\n          exploded = !exploded;\n          control.setAttribute(\"aria-pressed\", String(exploded));\n          control.classList.toggle(\"is-active\", exploded);\n          renderScene();\n          break;\n      }\n    } else if (target.closest(\".d3-detail-close\")) { selectedId = null; renderScene(); renderDetail(); }\n  }, { signal: aborter.signal });\n\n  container.addEventListener(\"keydown\", (event) => {\n    const target = event.target           ;\n    if ((event.key === \"Enter\" || event.key === \" \") && target.matches(\".d3-room, .d3-marker, .d3-slab\")) {\n      event.preventDefault();\n      const item = target               ;\n      if (item.dataset.placeId) selectPlace(item.dataset.placeId);\n      else if (item.dataset.floor) setFloor(item.dataset.floor           );\n    }\n    if (target === svg && [\"ArrowLeft\", \"ArrowRight\", \"ArrowUp\", \"ArrowDown\"].includes(event.key)) {\n      event.preventDefault();\n      if (event.key === \"ArrowLeft\") yaw -= 0.13;\n      if (event.key === \"ArrowRight\") yaw += 0.13;\n      if (event.key === \"ArrowUp\") pitch = Math.min(1.2, pitch + 0.08);\n      if (event.key === \"ArrowDown\") pitch = Math.max(0.22, pitch - 0.08);\n      renderScene();\n    }\n  }, { signal: aborter.signal });\n\n  svg.addEventListener(\"pointerdown\", (event) => {\n    if (event.button !== 0) return;\n    if (event.pointerType === \"touch\" && event.isPrimary) pinchStart = null;\n    if (pinchStart) return;\n    suppressModelClick = false;\n    pointerStart = { x: event.clientX, y: event.clientY, yaw, pitch };\n    dragged = false;\n  }, { signal: aborter.signal });\n  svg.addEventListener(\"pointermove\", (event) => {\n    if (!pointerStart || pinchStart) return;\n    const dx = event.clientX - pointerStart.x;\n    const dy = event.clientY - pointerStart.y;\n    if (event.pointerType === \"touch\" && !dragged && (Math.abs(dx) < 9 || Math.abs(dx) <= Math.abs(dy) * 1.15)) return;\n    if (!dragged && Math.abs(dx) + Math.abs(dy) > 5) {\n      dragged = true;\n      svg.setPointerCapture(event.pointerId);\n    }\n    if (!dragged) return;\n    yaw = pointerStart.yaw + dx * 0.009;\n    pitch = Math.max(0.20, Math.min(1.20, pointerStart.pitch - dy * 0.006));\n    renderScene();\n  }, { signal: aborter.signal });\n  svg.addEventListener(\"pointerup\", (event) => {\n    if (pointerStart && dragged) suppressModelClick = true;\n    pointerStart = null;\n    if (svg.hasPointerCapture(event.pointerId)) svg.releasePointerCapture(event.pointerId);\n  }, { signal: aborter.signal });\n  svg.addEventListener(\"pointercancel\", () => { pointerStart = null; }, { signal: aborter.signal });\n  stage.addEventListener(\"touchstart\", (event) => {\n    if (event.touches.length !== 2) return;\n    const first = event.touches[0], second = event.touches[1];\n    pinchStart = {\n      distance: Math.hypot(second.clientX - first.clientX, second.clientY - first.clientY),\n      zoom,\n      x: (first.clientX + second.clientX) / 2,\n      y: (first.clientY + second.clientY) / 2,\n      shiftX,\n      shiftY,\n    };\n    pointerStart = null;\n    event.preventDefault();\n  }, { passive: false, signal: aborter.signal });\n  stage.addEventListener(\"touchmove\", (event) => {\n    if (!pinchStart || event.touches.length !== 2) return;\n    event.preventDefault();\n    const first = event.touches[0], second = event.touches[1];\n    const distance = Math.hypot(second.clientX - first.clientX, second.clientY - first.clientY);\n    const midpointX = (first.clientX + second.clientX) / 2;\n    const midpointY = (first.clientY + second.clientY) / 2;\n    const pixelsToSvg = 1000 / svg.clientWidth;\n    zoom = Math.max(0.5, Math.min(3, pinchStart.zoom * distance / Math.max(1, pinchStart.distance)));\n    shiftX = pinchStart.shiftX + (midpointX - pinchStart.x) * pixelsToSvg;\n    shiftY = pinchStart.shiftY + (midpointY - pinchStart.y) * pixelsToSvg;\n    renderScene();\n  }, { passive: false, signal: aborter.signal });\n  stage.addEventListener(\"touchend\", (event) => { if (event.touches.length < 2) pinchStart = null; }, { signal: aborter.signal });\n  stage.addEventListener(\"touchcancel\", () => { pinchStart = null; }, { signal: aborter.signal });\n  for (const type of [\"gesturestart\", \"gesturechange\"]) {\n    stage.addEventListener(type, (event) => event.preventDefault(), { passive: false, signal: aborter.signal });\n  }\n  stage.addEventListener(\"wheel\", (event) => {\n    if (!event.ctrlKey && !event.metaKey) return;\n    event.preventDefault();\n    zoom = Math.max(0.5, Math.min(3, zoom + (event.deltaY < 0 ? 0.10 : -0.10)));\n    renderScene();\n  }, { passive: false, signal: aborter.signal });\n  search.addEventListener(\"input\", () => { query = search.value; renderResults(); }, { signal: aborter.signal });\n\n  renderResults(); render();\n  return { setFloor, selectPlace, resetView, destroy() { aborter.abort(); container.innerHTML = \"\"; container.classList.remove(\"nik-3d-app\"); } };\n}\n\nconst root = document.querySelector(\"#app\");\nif (root) mountNik3DMap(root);</script></body></html>"}